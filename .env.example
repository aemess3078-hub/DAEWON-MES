# ─────────────────────────────────────────────────────────────────────────────
# 대원정밀 MES 환경변수 템플릿
#  - 실제 값은 .env.local(로컬) / Vercel 환경변수(배포)에만 넣는다. 이 파일에는 값을 넣지 않는다.
#  - [필수] = 없으면 로그인/주요 기능이 동작하지 않음, [선택] = 없어도 기본 동작
#  - Vercel 배포 시 설정할 변수와 분류는 docs/DEPLOYMENT-VERCEL.md 참고 (Production/Preview 동일 변수, seed 전용 변수는 넣지 않음)
#  - NEXT_PUBLIC_* 값은 빌드 시점에 번들에 고정된다 → 값을 바꾸면 재배포(재빌드) 필요
# ─────────────────────────────────────────────────────────────────────────────

# ── [필수] DB (Prisma) ────────────────────────────────────────────────────────
# Supabase > Project Settings > Database > Connection string
#   DATABASE_URL : Transaction pooler (포트 6543, ?pgbouncer=true) — 앱 런타임용
#   DIRECT_URL   : Direct / Session 연결 (포트 5432) — prisma migrate 용(CLI 전용).
#                  앱 런타임은 사용하지 않는다 → Vercel Production/Preview 에는 넣지 않아도 된다(로컬/마이그레이션 작업용).
DATABASE_URL=
DIRECT_URL=

# ── [필수] 인증 (자체 JWT 세션) ───────────────────────────────────────────────
# 생성: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# POP 작업자 PIN / 세션 서명용 (JWT_SECRET 과 서로 다른 값 사용)
POP_PIN_SECRET=
POP_WORKER_SESSION_SECRET=

# ── [필수] 테넌트 ─────────────────────────────────────────────────────────────
# DB 의 Tenant.id 와 정확히 일치해야 한다 (seed-daewon.ts 가 이 값을 Tenant.id 로 생성).
# 불일치하면 로그인이 계속 실패한다. NMES 데모 값(tenant-demo-001)을 쓰지 말 것.
DEFAULT_TENANT_ID=

# ── 브랜드 ────────────────────────────────────────────────────────────────────
# daewon = 대원정밀 (기본). newmes 는 NMES 개발 서버 전용 분기이므로 사용하지 않는다.
NEXT_PUBLIC_BRAND=daewon

# ── [필수: 첨부파일/작업표준서 업로드] Supabase Storage ───────────────────────
# 이 프로젝트는 @supabase/supabase-js 를 쓰지 않고 Storage REST API 를 service_role 키로 호출한다.
# (Supabase Auth 미사용 → NEXT_PUBLIC_SUPABASE_ANON_KEY 는 현재 코드에서 사용하지 않아 두지 않는다)
# SERVICE_ROLE 키는 서버 전용 — NEXT_PUBLIC_ 로 노출 금지.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── [선택] Prisma 커넥션 풀 튜닝 ──────────────────────────────────────────────
# 미설정 시 기본값: PRISMA_CONNECTION_LIMIT=2, PRISMA_POOL_TIMEOUT=10, PRISMA_CONNECT_TIMEOUT=10
# 운영 권장 예: PRISMA_CONNECTION_LIMIT=8  (Supabase pooler 한도를 넘지 않도록)
PRISMA_CONNECTION_LIMIT=
PRISMA_POOL_TIMEOUT=
PRISMA_CONNECT_TIMEOUT=

# ── [선택] 백업관리 화면 (현재 메뉴 숨김) ─────────────────────────────────────
# Supabase Management API 읽기 전용 Access Token. 미설정 시 해당 화면만 "정보를 불러올 수 없음".
SUPABASE_MANAGEMENT_ACCESS_TOKEN=

# ── [선택] AI 기능 (현재 UI 에서 숨김 — MRP 화면의 AI 제안만 사용) ───────────
# AI_ENABLED=true 이고 OPENAI_API_KEY 가 있을 때만 동작. 기본은 비활성.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_ADVANCED=

# ── [선택] NCWatch 설비 연계 (연계 방식 미확정 — 사용 시에만) ─────────────────
# 값이 같을 때의 정기 TagSnapshot 간격(ms). 미설정/빈 값이면 900000(15분). 값이 바뀌면 간격과 무관하게 즉시 저장.
# (Vercel 에 이 변수가 이미 설정돼 있으면 그 값이 우선하므로 60000 등 작은 값이면 저장량이 줄지 않는다)
NCWATCH_SNAPSHOT_INTERVAL_MS=
# 선택: 위치·회전수 같은 변동 태그의 변경 스냅샷 최소 간격(ms). 미설정/0 이면 변경 즉시 저장. 예: 60000
NCWATCH_SNAPSHOT_VOLATILE_MIN_INTERVAL_MS=

# ─────────────────────────────────────────────────────────────────────────────
# seed 전용 (npm run db:seed → prisma/seed-daewon.ts). 앱 런타임에서는 사용하지 않는다.
# 로컬에서 1회만 셸 환경변수/.env.local 로 주입해 실행한다. **Vercel 환경변수에는 절대 넣지 않는다.**
# ─────────────────────────────────────────────────────────────────────────────
# SEED_ADMIN_LOGIN_ID=
# SEED_ADMIN_PASSWORD=          # 관리자 비밀번호(8자 이상). bcrypt 해시만 저장, 이 계정은 mustChangePw=false(운영 정책)
# SEED_ADMIN_NAME=              # 선택 (기본: 시스템 관리자)
# SEED_ADMIN_EMAIL=             # 선택 (기본: <loginId>@daewon-mes.internal)
# DAEWON_SEED_CONFIRM=YES       # 대상 DB 를 확인한 뒤에만 설정
# SEED_DEVELOPER_LOGIN_ID=test     # 개발/유지보수 계정(loginId 는 반드시 test — 코드가 loginId 로 개발자 판정)
# SEED_DEVELOPER_PASSWORD=        # 8자 이상. bcrypt 해시만 저장. 이미 seed 된 DB 에는 SEED_ONLY=developer 로 이 계정만 추가
