// ─── Phase 2d-5: 영업관리 ─────────────────────────────────────────────────────

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  PARTIAL_SHIPPED
  SHIPPED
  CLOSED
  CANCELLED
}

enum ShipmentStatus {
  PLANNED
  PICKED
  SHIPPED
  DELIVERED
  CANCELLED
}

model SalesOrder {
  id           String           @id @default(cuid())
  tenantId     String
  siteId       String
  customerId   String
  orderNo      String
  orderDate    DateTime
  deliveryDate DateTime
  status       SalesOrderStatus @default(DRAFT)
  totalAmount  Decimal?         @db.Decimal(18, 2)
  currency     String           @default("KRW")
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant             Tenant              @relation("TenantSalesOrders", fields: [tenantId], references: [id])
  site               Site                @relation("SiteSalesOrders", fields: [siteId], references: [id])
  customer           BusinessPartner     @relation("CustomerSalesOrders", fields: [customerId], references: [id])
  items              SalesOrderItem[]
  shipments          ShipmentOrder[]
  projectOrders      ProjectOrder[]      @relation("SalesOrderProjectOrders")
  projectOrderPrices ProjectOrderPrice[] @relation("SalesOrderProjectOrderPrices")

  @@unique([tenantId, orderNo])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([tenantId, deliveryDate])
}

model SalesOrderItem {
  id           String    @id @default(cuid())
  salesOrderId String
  itemId       String
  qty          Decimal   @db.Decimal(18, 6)
  unitPrice    Decimal?  @db.Decimal(18, 2)
  deliveryDate DateTime?
  producedQty  Decimal   @default(0) @db.Decimal(18, 6)
  shippedQty   Decimal   @default(0) @db.Decimal(18, 6)
  note         String?

  salesOrder          SalesOrder           @relation(fields: [salesOrderId], references: [id])
  item                Item                 @relation("ItemSalesOrderItems", fields: [itemId], references: [id])
  productionPlanItems ProductionPlanItem[]
  shipmentItems       ShipmentItem[]

  @@unique([salesOrderId, itemId])
  @@index([salesOrderId])
  @@index([itemId])
}

model ShipmentOrder {
  id            String         @id @default(cuid())
  tenantId      String
  siteId        String
  salesOrderId  String
  shipmentNo    String
  status        ShipmentStatus @default(PLANNED)
  plannedDate   DateTime
  shippedDate   DateTime?
  deliveredDate DateTime?
  warehouseId   String?
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant     Tenant         @relation("TenantShipmentOrders", fields: [tenantId], references: [id])
  site       Site           @relation("SiteShipmentOrders", fields: [siteId], references: [id])
  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id])
  warehouse  Warehouse?     @relation("WarehouseShipments", fields: [warehouseId], references: [id])
  items      ShipmentItem[]

  @@unique([tenantId, shipmentNo])
  @@index([tenantId])
  @@index([salesOrderId])
}

model ShipmentItem {
  id               String  @id @default(cuid())
  shipmentOrderId  String
  salesOrderItemId String
  itemId           String
  qty              Decimal @db.Decimal(18, 6)
  lotId            String?

  shipmentOrder  ShipmentOrder  @relation(fields: [shipmentOrderId], references: [id])
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  item           Item           @relation("ItemShipmentItems", fields: [itemId], references: [id])
  lot            Lot?           @relation("LotShipmentItems", fields: [lotId], references: [id])

  @@index([shipmentOrderId])
  @@index([salesOrderItemId])
}

// ─── Phase 2d-6: 구매관리 ─────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum ReceivingInspectionResult {
  PASS
  FAIL
  CONDITIONAL
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  tenantId     String
  siteId       String
  supplierId   String
  orderNo      String
  orderDate    DateTime
  expectedDate DateTime
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Decimal?            @db.Decimal(18, 2)
  currency     String              @default("KRW")
  note         String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant                Tenant                 @relation("TenantPurchaseOrders", fields: [tenantId], references: [id])
  site                  Site                   @relation("SitePurchaseOrders", fields: [siteId], references: [id])
  supplier              BusinessPartner        @relation("SupplierPurchaseOrders", fields: [supplierId], references: [id])
  items                 PurchaseOrderItem[]
  lotNumberReservations LotNumberReservation[]
  materialReturns       MaterialReturn[]

  @@unique([tenantId, orderNo])
  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id                   String  @id @default(cuid())
  purchaseOrderId      String
  itemId               String
  workOrderOperationId String?
  qty                  Decimal @db.Decimal(18, 6)
  unitPrice            Decimal @db.Decimal(18, 2)
  receivedQty          Decimal @default(0) @db.Decimal(18, 6)
  stockAtOrder         Decimal @default(0) @db.Decimal(18, 6)
  note                 String?

  purchaseOrder         PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id])
  item                  Item                   @relation("ItemPurchaseOrderItems", fields: [itemId], references: [id])
  workOrderOperation    WorkOrderOperation?    @relation("OutsourcingOperationPurchaseItems", fields: [workOrderOperationId], references: [id])
  receivingInspections  ReceivingInspection[]
  lotNumberReservations LotNumberReservation[]
  materialReturnItems   MaterialReturnItem[]

  @@unique([purchaseOrderId, itemId])
  @@index([purchaseOrderId])
  @@index([itemId])
  @@index([workOrderOperationId])
}

model ReceivingInspection {
  id                  String                    @id @default(cuid())
  purchaseOrderItemId String
  inspectorId         String?
  receivedQty         Decimal                   @db.Decimal(18, 6)
  acceptedQty         Decimal                   @db.Decimal(18, 6)
  rejectedQty         Decimal                   @default(0) @db.Decimal(18, 6)
  result              ReceivingInspectionResult
  inspectedAt         DateTime                  @default(now())
  note                String?

  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  inspector         Profile?          @relation("ReceivingInspector", fields: [inspectorId], references: [id])

  @@index([purchaseOrderItemId])
}

// ─── 청운커팅 사업계획서 "자재관리 > 반품관리" (PR #50) ────────────────────────
//
// 정상 입고되어 회사 재고가 된 자재를 공급사에 반품하는 업무만 다룬다. 입고검사
// 불합격 수량의 공급사 반송(ReceivingInspection.rejectedQty 처리)은 별개 워크플로
// 이며 이번 PR의 범위가 아니다 — 이 모델은 이미 InventoryBalance에 반영된
// 가용재고를 outbound(-)로 차감하는 케이스만 다룬다.
//
// MaterialReturnStatus는 DRAFT/COMPLETED/CANCELLED 3개만 사용한다. 별도의
// 전자결재/승인 워크플로(CONFIRMED 등 중간 상태)는 만들지 않는다 — COMPLETED
// 전환 자체가 재고차감을 트리거하는 단일 승인 지점이다(권한: MANAGER 이상).
enum MaterialReturnStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model MaterialReturn {
  id              String               @id @default(cuid())
  tenantId        String
  // 반품 건 전체를 하나의 사업장으로 고정한다 — 품목별 warehouse/LOT 재고 조회와
  // PO 연계 검증이 모두 이 siteId 기준으로 스코프된다(§4). 한 반품 건에 여러
  // 사업장의 재고가 섞이는 것을 막기 위한 필수 필드다.
  siteId          String
  supplierId      String
  purchaseOrderId String?
  returnNo        String // 반품번호, 예: SR-2026-001
  status          MaterialReturnStatus @default(DRAFT)
  reason          String?
  note            String?
  createdById     String
  // COMPLETED 전환 시각/주체만 기록한다 — confirmedById/confirmedAt은 만들지 않는다(중간
  // 승인 단계가 없으므로). CANCELLED는 DRAFT에서만 가능한 단순 종료이므로 별도의
  // cancelledById/cancelledAt 컬럼 없이 AuditLog(actorId/actedAt)로 충분히 추적된다.
  completedById   String?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  site          Site                 @relation(fields: [siteId], references: [id])
  supplier      BusinessPartner      @relation("SupplierMaterialReturns", fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  createdBy     Profile              @relation("MaterialReturnCreator", fields: [createdById], references: [id])
  completedBy   Profile?             @relation("MaterialReturnCompleter", fields: [completedById], references: [id])
  items         MaterialReturnItem[]

  @@unique([tenantId, returnNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([siteId])
  @@index([supplierId])
  @@index([purchaseOrderId])
}

model MaterialReturnItem {
  id                     String  @id @default(cuid())
  materialReturnId       String
  itemId                 String
  purchaseOrderItemId    String?
  // LOT 관리 품목은 기존 LOT 선택만 허용한다(신규 LOT 생성 금지) — 비LOT 품목은 null.
  lotId                  String?
  warehouseId            String
  returnQty              Decimal @db.Decimal(18, 6)
  note                   String?
  // COMPLETED 전환 시 생성되는 SUPPLIER_RETURN InventoryTransaction 추적용. DRAFT
  // 동안은 null이며, 완료 후에는 수정/삭제/취소가 전면 금지되므로 재사용되지 않는다.
  inventoryTransactionId String? @unique

  materialReturn       MaterialReturn        @relation(fields: [materialReturnId], references: [id], onDelete: Cascade)
  item                 Item                  @relation(fields: [itemId], references: [id])
  purchaseOrderItem    PurchaseOrderItem?    @relation(fields: [purchaseOrderItemId], references: [id])
  lot                  Lot?                  @relation(fields: [lotId], references: [id])
  warehouse            Warehouse             @relation(fields: [warehouseId], references: [id])
  inventoryTransaction InventoryTransaction? @relation(fields: [inventoryTransactionId], references: [id])

  @@index([materialReturnId])
  @@index([itemId])
  @@index([purchaseOrderItemId])
  @@index([lotId])
  @@index([warehouseId])
}

model ItemPrice {
  id            String    @id @default(cuid())
  tenantId      String
  itemId        String
  partnerId     String
  priceType     String
  unitPrice     Decimal   @db.Decimal(18, 2)
  currency      String    @default("KRW")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  note          String?
  createdAt     DateTime  @default(now())

  tenant  Tenant          @relation("TenantItemPrices", fields: [tenantId], references: [id])
  item    Item            @relation("ItemPrices", fields: [itemId], references: [id])
  partner BusinessPartner @relation("PartnerPrices", fields: [partnerId], references: [id])

  @@index([tenantId, itemId, partnerId])
  @@index([tenantId, priceType])
}

// ─── Phase 5A: 품목별 공급업체 기준정보 ─────────────────────────────────────────────
//
// 품목 ↔ 공급업체(BusinessPartner SUPPLIER|BOTH) 관계와 발주 조건(리드타임/MOQ/발주배수).
// 가격은 저장하지 않는다(단가/이력은 ItemPrice). 안전재고는 Phase 5D(Item.safetyStock).
// - (tenantId, itemId, supplierId) 유일.
// - 품목당 ACTIVE Default 최대 1개: PostgreSQL partial unique index(ItemSupplier_one_active_default_per_item)로
//   migration SQL 에서 보장한다(Prisma schema 로 표현 불가 — 서비스 로직과 이중 방어).
// - 비활성(isActive=false) 관계는 isDefault 를 유지하지 않는다(서비스에서 함께 해제).
// - 품목 삭제 시(이미 이력 참조 검사를 통과한 품목) 관계도 함께 정리(Cascade). 공급업체는 Restrict.
model ItemSupplier {
  id            String   @id @default(cuid())
  tenantId      String
  itemId        String
  supplierId    String
  isDefault     Boolean  @default(false)
  priority      Int      @default(100) // 작을수록 우선
  leadTimeDays  Int? // null = 미설정, 0 = 당일
  moq           Decimal? @db.Decimal(18, 6) // null = 미설정, > 0
  orderMultiple Decimal? @db.Decimal(18, 6) // null = 미설정, > 0
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant          @relation("TenantItemSuppliers", fields: [tenantId], references: [id])
  item     Item            @relation("ItemItemSuppliers", fields: [itemId], references: [id], onDelete: Cascade)
  supplier BusinessPartner @relation("SupplierItemSuppliers", fields: [supplierId], references: [id])

  @@unique([tenantId, itemId, supplierId])
  @@index([tenantId, itemId])
  @@index([tenantId, supplierId])
}

// ─── Phase 2d-AI: AI 사용량 로그 ────────────────────────────────────────────

model AIUsageLog {
  id               String   @id @default(cuid())
  tenantId         String
  feature          String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  costEstimate     Decimal? @db.Decimal(10, 6)
  requestSummary   String?
  createdAt        DateTime @default(now())

  tenant Tenant @relation("TenantAIUsageLogs", fields: [tenantId], references: [id])

  @@index([tenantId, feature])
  @@index([tenantId, createdAt])
  @@index([createdAt])
}

// ─── Phase 2d-8: 견적관리 ─────────────────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  SUBMITTED
  NEGOTIATING
  WON
  LOST
  EXPIRED
  CANCELLED
}

model Quotation {
  id                    String          @id @default(cuid())
  tenantId              String
  siteId                String
  customerId            String
  quotationNo           String
  quotationDate         DateTime
  validUntil            DateTime
  status                QuotationStatus @default(DRAFT)
  totalAmount           Decimal?        @db.Decimal(18, 2)
  currency              String          @default("KRW")
  note                  String?
  convertedSalesOrderId String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  tenant             Tenant              @relation("TenantQuotations", fields: [tenantId], references: [id])
  site               Site                @relation("SiteQuotations", fields: [siteId], references: [id])
  customer           BusinessPartner     @relation("CustomerQuotations", fields: [customerId], references: [id])
  items              QuotationItem[]
  projectOrderPrices ProjectOrderPrice[]

  @@unique([tenantId, quotationNo])
  @@index([tenantId, status])
  @@index([customerId])
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  itemId      String
  qty         Decimal @db.Decimal(18, 6)
  unitPrice   Decimal @db.Decimal(18, 2)
  note        String?

  quotation Quotation @relation(fields: [quotationId], references: [id])
  item      Item      @relation("ItemQuotationItems", fields: [itemId], references: [id])

  @@unique([quotationId, itemId])
  @@index([quotationId])
  @@index([itemId])
}

// ─── Phase 2d-8b: 영업관리 — 프로젝트 오더 ───────────────────────────────────────
//
// 청운커팅 사업계획서 "영업관리 > 프로젝트 오더": 수주와 생산실행 사이를 잇는
// 프로젝트 단위 업무 Header. §3 개념도(거래처→수주관리→프로젝트오더)와 §9/§15
// 필드 목록에 따라 연결 대상은 SalesOrder만 다룬다 — 견적(Quotation) 연동은
// 이번 PR의 명시적 범위 밖이라 quotationId는 두지 않는다(§22). 견적금액/납품
// 완료일 등은 이미 SalesOrder/Quotation에 있으므로 여기서 중복 저장하지 않고
// salesOrderId로만 참조한다 (§4). 프로젝트 진행률/단계/이슈/대금관리는 PR #48+.

enum ProjectOrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectOrderPriority {
  LOW
  MEDIUM
  HIGH
}

model ProjectOrder {
  id               String               @id @default(cuid())
  tenantId         String
  siteId           String
  code             String // 프로젝트 오더번호, 예: PROJ-2026-001
  name             String // 프로젝트명
  customerId       String
  itemId           String?
  salesOrderId     String? // 연결 수주 (수주확정 시)
  ownerId          String // 담당자
  priority         ProjectOrderPriority @default(MEDIUM)
  status           ProjectOrderStatus   @default(DRAFT)
  plannedStartDate DateTime?
  dueDate          DateTime?
  description      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant     Tenant             @relation("TenantProjectOrders", fields: [tenantId], references: [id])
  site       Site               @relation("SiteProjectOrders", fields: [siteId], references: [id])
  customer   BusinessPartner    @relation("CustomerProjectOrders", fields: [customerId], references: [id])
  item       Item?              @relation("ItemProjectOrders", fields: [itemId], references: [id])
  salesOrder SalesOrder?        @relation("SalesOrderProjectOrders", fields: [salesOrderId], references: [id])
  owner      Profile            @relation("ProjectOrderOwner", fields: [ownerId], references: [id])
  stages     ProjectStage[]
  issues     ProjectIssue[]
  price      ProjectOrderPrice?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([customerId])
  @@index([salesOrderId])
}

// ─── Phase 2d-8c: 프로젝트관리 — 프로젝트 진행현황(ProjectStage) ───────────────────
//
// 프로젝트관리 > 프로젝트 진행현황: ProjectOrder 하위의 순차 단계 관리.
// sourceRoutingOperationId는 "어디서 가져온 단계인지" 추적용 nullable 참조일 뿐,
// RoutingOperation의 실시간 mirror가 아니다 — 라우팅에서 가져오는 순간 name/seq를
// snapshot으로 복사해 저장하며, 이후 Routing이 수정되어도 기존 ProjectStage는
// 자동으로 바뀌지 않는다(§4). 진행률/현재단계/지연여부는 DB에 저장하지 않고
// 화면/서비스에서 매번 계산한다(§5,§6,§13). 생산실적(ProductionPlan/WorkOrder)과의
// 직접 FK 연결은 이번 PR 범위 밖이다(§17).

enum ProjectStageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model ProjectStage {
  id                       String             @id @default(cuid())
  tenantId                 String
  projectOrderId           String
  seq                      Int
  name                     String
  status                   ProjectStageStatus @default(PENDING)
  plannedStartDate         DateTime?
  dueDate                  DateTime?
  startedAt                DateTime?
  completedAt              DateTime?
  sourceRoutingOperationId String? // 가져온 출처 추적용(nullable) — mirror 아님, snapshot임
  note                     String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  tenant                 Tenant            @relation(fields: [tenantId], references: [id])
  projectOrder           ProjectOrder      @relation(fields: [projectOrderId], references: [id])
  sourceRoutingOperation RoutingOperation? @relation(fields: [sourceRoutingOperationId], references: [id])

  @@unique([projectOrderId, seq])
  @@index([tenantId])
  @@index([projectOrderId])
  @@index([sourceRoutingOperationId])
}

// ─── Phase 2d-8d: 프로젝트관리 — 이슈 관리(ProjectIssue) ────────────────────────
//
// 프로젝트관리 > 이슈 관리: ProjectOrder 하위에서 발생하는 문제/리스크를
// 등록→담당자지정→조치진행→해결 흐름으로 추적한다. 품질검사의 불량 원인분석/
// 시정조치/재발방지와는 완전히 분리된 별개 도메인이다(품질 불량은 DefectRecord/
// QualityInspection 쪽 책임) — DefectSeverity 등 품질 enum을 재사용하지 않는다.
// 이번 PR에서는 ProjectStage와 직접 FK를 연결하지 않는다 — Issue는 ProjectOrder
// 단위로만 관리한다(향후 특정 단계 연결 요구가 생기면 확장). 지연여부는 DB에
// 저장하지 않고 화면/서비스에서 매번 계산한다(src/lib/project-issue-calculations.ts).

enum ProjectIssueType {
  ISSUE
  RISK
}

enum ProjectIssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model ProjectIssue {
  id             String               @id @default(cuid())
  tenantId       String
  projectOrderId String
  code           String // 이슈번호, 예: ISS-2026-001
  type           ProjectIssueType     @default(ISSUE)
  severity       ProjectIssueSeverity @default(MEDIUM)
  status         ProjectIssueStatus   @default(OPEN)
  title          String
  description    String?
  assigneeId     String?
  occurredAt     DateTime
  dueDate        DateTime?
  resolution     String?
  resolvedAt     DateTime?
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tenant       Tenant       @relation("TenantProjectIssues", fields: [tenantId], references: [id])
  projectOrder ProjectOrder @relation(fields: [projectOrderId], references: [id])
  assignee     Profile?     @relation("ProjectIssueAssignee", fields: [assigneeId], references: [id])
  createdBy    Profile      @relation("ProjectIssueCreator", fields: [createdById], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([projectOrderId])
  @@index([assigneeId])
}

// ─── 청운커팅 사업계획서 "영업관리 > 프로젝트 단가관리" (PR #52A) ────────────────
//
// ProjectOrder에 단가 필드를 직접 얹지 않고 별도 모델로 분리한다 — 견적단가/
// 수주단가/최종결정단가를 "그 시점의 값 snapshot"으로 보존해야 하고(원본
// Quotation/SalesOrder가 나중에 수정되어도 과거 분석 결과가 바뀌면 안 됨),
// ProjectOrder는 이미 book-keeping 책임이 많아 가격 이력까지 얹으면 과밀해진다.
//
// ProjectOrder당 현재 단가관리 레코드는 1건뿐이다(@@unique([tenantId,
// projectOrderId])) — 여러 품목/여러 라인 가격은 다루지 않는다(ProjectOrder
// 자체가 단일 itemId만 갖는 현재 구조와 대칭).
//
// quotationId/salesOrderId는 "이 snapshot이 어느 문서에서 왔는지"를 가리키는
// 참조일 뿐이고, 실제 비교/집계에 쓰이는 값은 항상 quotationUnitPrice/
// orderUnitPrice/quantity/currency 컬럼의 snapshot이다 — 원본이 나중에 수정돼도
// 이 값들은 그대로다. 단, 원본 "삭제"는 값 불변과 별개 문제다: quotationId/
// salesOrderId FK는 onDelete Restrict이므로, ProjectOrderPrice가 참조하는 동안은
// 원본 Quotation/SalesOrder를 삭제할 수 없다(source 추적성 보존 — FK가 null이
// 되면 어느 문서에서 온 snapshot인지 알 수 없어지고 currency/불변성 정책 판단도
// 깨진다). DRAFT 가격관리 레코드를 먼저 삭제하면 그 뒤로는 원본 삭제가 다시
// 가능하고, DECIDED는 hard delete를 만들지 않으므로 연결된 source도 가격 이력과
// 함께 영구 보존된다.
enum ProjectPriceStatus {
  DRAFT
  DECIDED
}

model ProjectOrderPrice {
  id             String @id @default(cuid())
  tenantId       String
  // ProjectOrder 쪽 1:1 back-relation(price ProjectOrderPrice?)이 유효하려면
  // Prisma가 이 필드에 @unique를 요구한다 — 아래 @@unique([tenantId,
  // projectOrderId]) 복합 unique와 사실상 중복이지만, 후자는 기존 코드베이스의
  // tenant-scoped unique 관례(예: @@unique([tenantId, code]))와 표기를 맞추기
  // 위해 그대로 유지한다.
  projectOrderId String @unique

  // 참조용 — 실제 비교 값은 아래 snapshot 컬럼을 쓴다(§ 상단 설명 참고).
  quotationId  String?
  salesOrderId String?

  itemId   String
  quantity Decimal @db.Decimal(18, 6)

  quotationUnitPrice Decimal? @db.Decimal(18, 2)
  orderUnitPrice     Decimal? @db.Decimal(18, 2)
  finalUnitPrice     Decimal? @db.Decimal(18, 2)

  currency String             @default("KRW")
  status   ProjectPriceStatus @default(DRAFT)

  quotationDate DateTime?
  orderDate     DateTime?

  // DECIDED 전환 시각/주체 — 최초 결정 시점을 가리킨다. 이후 재결정 시에도 이
  // 필드들은 "가장 최근 결정"으로 갱신되고, 결정이 바뀌어온 과정 자체는
  // ProjectOrderPriceRevision이 별도로 보존한다.
  decidedAt      DateTime?
  decidedById    String?
  decisionReason String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant                      @relation(fields: [tenantId], references: [id])
  projectOrder ProjectOrder                @relation(fields: [projectOrderId], references: [id])
  // quotationId/salesOrderId는 nullable이라 Prisma 기본 onDelete는 SetNull이지만,
  // 그 기본값은 가격 원장의 source 추적성과 충돌한다 — 원본이 삭제돼 FK가 null이
  // 되면 어떤 견적/수주에서 이 snapshot이 나왔는지 알 수 없게 되고, salesOrderId
  // source-presence로 currency/불변성 정책을 판단하는 로직도 오동작한다. 그래서
  // ProjectOrderPrice가 참조 중인 동안은 원본 Quotation/SalesOrder 삭제 자체를
  // 막는다(Restrict) — DRAFT 가격을 먼저 지우면 그 뒤로는 기존 삭제 흐름 그대로 가능하다.
  quotation    Quotation?                  @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  salesOrder   SalesOrder?                 @relation("SalesOrderProjectOrderPrices", fields: [salesOrderId], references: [id], onDelete: Restrict)
  item         Item                        @relation("ItemProjectOrderPrices", fields: [itemId], references: [id])
  decidedBy    Profile?                    @relation("ProjectOrderPriceDecider", fields: [decidedById], references: [id])
  createdBy    Profile                     @relation("ProjectOrderPriceCreator", fields: [createdById], references: [id])
  updatedBy    Profile?                    @relation("ProjectOrderPriceUpdater", fields: [updatedById], references: [id])
  revisions    ProjectOrderPriceRevision[]

  @@unique([tenantId, projectOrderId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, decidedAt])
  @@index([quotationId])
  @@index([salesOrderId])
  @@index([itemId])
}

// finalUnitPrice가 바뀔 때마다(최초 DECIDED 전환 포함) 1건씩 쌓인다 — 사용자가
// 볼 "가격 흐름 타임라인" 전용 데이터다. AuditLog(시스템 감사 추적)와 목적이
// 다르므로 역할이 겹치지 않는다: 여기는 "가격이 어떻게 흘러왔는가"만 담고,
// 누가 어떤 필드를 언제 바꿨는지의 전체 스냅샷은 AuditLog가 별도로 남긴다.
// ProjectStage/ProjectIssue와 같은 이유로 tenantId를 직접 갖는다 — 상위
// ProjectOrder 계열 레코드들의 기존 관례(직접 조회/tenant 격리 방어)를 따른다.
model ProjectOrderPriceRevision {
  id                     String   @id @default(cuid())
  tenantId               String
  projectOrderPriceId    String
  previousFinalUnitPrice Decimal? @db.Decimal(18, 2)
  newFinalUnitPrice      Decimal  @db.Decimal(18, 2)
  reason                 String?
  changedById            String
  changedAt              DateTime @default(now())

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  projectOrderPrice ProjectOrderPrice @relation(fields: [projectOrderPriceId], references: [id])
  changedBy         Profile           @relation("ProjectOrderPriceRevisionChanger", fields: [changedById], references: [id])

  @@index([tenantId])
  @@index([projectOrderPriceId])
}

// ─── Phase 2d-9: 원가관리 ─────────────────────────────────────────────────────

model ItemCost {
  id           String   @id @default(cuid())
  tenantId     String
  itemId       String
  costType     String
  materialCost Decimal  @db.Decimal(18, 2)
  laborCost    Decimal  @db.Decimal(18, 2)
  overheadCost Decimal  @db.Decimal(18, 2)
  totalCost    Decimal  @db.Decimal(18, 2)
  bomId        String?
  workOrderId  String?
  calculatedAt DateTime @default(now())
  note         String?

  tenant    Tenant     @relation("TenantItemCosts", fields: [tenantId], references: [id])
  item      Item       @relation("ItemCosts", fields: [itemId], references: [id])
  bom       BOM?       @relation("BOMItemCosts", fields: [bomId], references: [id])
  workOrder WorkOrder? @relation("WorkOrderItemCosts", fields: [workOrderId], references: [id])

  @@index([tenantId, itemId, costType])
  @@index([tenantId, calculatedAt])
  @@index([bomId])
  @@index([workOrderId])
}

// ─── Phase 2d-10: 변경관리 (ECN/ECO) ─────────────────────────────────────────

model EngineeringChange {
  id            String    @id @default(cuid())
  tenantId      String
  ecnNo         String
  title         String
  reason        String
  changeType    String
  targetItemId  String
  status        ECNStatus @default(DRAFT)
  requestedBy   String
  approvedBy    String?
  requestedAt   DateTime  @default(now())
  approvedAt    DateTime?
  implementedAt DateTime?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant    Tenant                    @relation("TenantECNs", fields: [tenantId], references: [id])
  item      Item                      @relation("ItemECNs", fields: [targetItemId], references: [id])
  requester Profile                   @relation("ECNRequester", fields: [requestedBy], references: [id])
  approver  Profile?                  @relation("ECNApprover", fields: [approvedBy], references: [id])
  details   EngineeringChangeDetail[]

  @@unique([tenantId, ecnNo])
  @@index([tenantId, status])
  @@index([targetItemId])
}

model EngineeringChangeDetail {
  id                  String  @id @default(cuid())
  engineeringChangeId String
  changeTarget        String
  actionType          String
  beforeValue         Json?
  afterValue          Json?
  description         String?

  engineeringChange EngineeringChange @relation(fields: [engineeringChangeId], references: [id])

  @@index([engineeringChangeId])
}

// ─── LMS: 설비관리 (수리요청/일상점검) ───────────────────────────────────────

enum RepairRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RepairPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CheckResult {
  PASS
  FAIL
  NA
}

enum EquipmentDowntimeKind {
  PLANNED
  UNPLANNED
}

enum PreventiveMaintenanceCycleUnit {
  DAY
  WEEK
  MONTH
}

// ─── Support Request Enums ────────────────────────────────────────────────────

enum SupportType {
  BUG_REPORT
  FEATURE_REQUEST
  IMPROVEMENT
  OTHER
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  ON_HOLD
  COMPLETED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model EquipmentProblemType {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  category    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant                   @relation(fields: [tenantId], references: [id])
  repairRequests EquipmentRepairRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model EquipmentRepairRequest {
  id            String              @id @default(cuid())
  tenantId      String
  siteId        String
  equipmentId   String
  problemTypeId String?
  requestNo     String
  title         String
  description   String?
  priority      RepairPriority      @default(MEDIUM)
  status        RepairRequestStatus @default(OPEN)
  requestedBy   String
  assignedTo    String?
  startedAt     DateTime?
  completedAt   DateTime?
  note          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  site        Site                  @relation(fields: [siteId], references: [id])
  equipment   Equipment             @relation(fields: [equipmentId], references: [id])
  problemType EquipmentProblemType? @relation(fields: [problemTypeId], references: [id])
  requester   Profile               @relation("RepairRequester", fields: [requestedBy], references: [id])
  assignee    Profile?              @relation("RepairAssignee", fields: [assignedTo], references: [id])

  downtimeRecords EquipmentDowntime[]

  @@unique([tenantId, requestNo])
  @@index([tenantId])
  @@index([equipmentId])
  @@index([status])
}

model EquipmentDailyCheck {
  id          String      @id @default(cuid())
  tenantId    String
  siteId      String
  equipmentId String
  checkDate   DateTime    @db.Date
  checkedBy   String
  result      CheckResult @default(PASS)
  note        String?
  items       Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  site      Site      @relation(fields: [siteId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])
  checker   Profile   @relation("DailyCheckChecker", fields: [checkedBy], references: [id])

  @@unique([equipmentId, checkDate])
  @@index([tenantId])
  @@index([equipmentId, checkDate])
}

model EquipmentDowntime {
  id               String                @id @default(cuid())
  tenantId         String
  siteId           String
  equipmentId      String
  reasonId         String
  eventType        EquipmentEventType    @default(STOP)
  kind             EquipmentDowntimeKind @default(UNPLANNED)
  startedAt        DateTime
  endedAt          DateTime?
  note             String?
  equipmentEventId String?               @unique
  repairRequestId  String?
  createdById      String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  site           Site                    @relation(fields: [siteId], references: [id])
  equipment      Equipment               @relation(fields: [equipmentId], references: [id])
  reason         CommonCode              @relation("DowntimeReason", fields: [reasonId], references: [id])
  equipmentEvent EquipmentEvent?         @relation("EquipmentEventDowntime", fields: [equipmentEventId], references: [id], onDelete: SetNull)
  repairRequest  EquipmentRepairRequest? @relation(fields: [repairRequestId], references: [id], onDelete: SetNull)
  createdBy      Profile                 @relation("EquipmentDowntimeCreator", fields: [createdById], references: [id])

  @@index([tenantId, startedAt])
  @@index([equipmentId, startedAt])
  @@index([reasonId])
  @@index([repairRequestId])
}

model EquipmentMaintenancePlan {
  id              String                         @id @default(cuid())
  tenantId        String
  siteId          String
  equipmentId     String
  title           String
  description     String?
  cycleValue      Int
  cycleUnit       PreventiveMaintenanceCycleUnit
  startDate       DateTime
  nextDueAt       DateTime
  lastCompletedAt DateTime?
  isActive        Boolean                        @default(true)
  createdById     String
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  tenant    Tenant                        @relation(fields: [tenantId], references: [id])
  site      Site                          @relation(fields: [siteId], references: [id])
  equipment Equipment                     @relation(fields: [equipmentId], references: [id])
  createdBy Profile                       @relation("EquipmentMaintenancePlanCreator", fields: [createdById], references: [id])
  histories EquipmentMaintenanceHistory[]

  @@index([tenantId, nextDueAt])
  @@index([equipmentId, nextDueAt])
}

model EquipmentMaintenanceHistory {
  id          String      @id @default(cuid())
  tenantId    String
  siteId      String
  equipmentId String
  planId      String
  scheduledAt DateTime
  completedAt DateTime
  result      CheckResult @default(PASS)
  note        String?
  performedBy String
  createdAt   DateTime    @default(now())

  tenant    Tenant                   @relation(fields: [tenantId], references: [id])
  site      Site                     @relation(fields: [siteId], references: [id])
  equipment Equipment                @relation(fields: [equipmentId], references: [id])
  plan      EquipmentMaintenancePlan @relation(fields: [planId], references: [id])
  performer Profile                  @relation("EquipmentMaintenancePerformer", fields: [performedBy], references: [id])

  @@unique([planId, scheduledAt])
  @@index([tenantId, completedAt])
  @@index([equipmentId, completedAt])
}

// ─── Custom Auth ─────────────────────────────────────────────────────────────

model UserCredential {
  id                String    @id @default(cuid())
  tenantId          String
  loginId           String
  profileId         String    @unique
  passwordHash      String
  popPinHash        String?
  popPinFingerprint String?
  popPinSetAt       DateTime?
  mustChangePw      Boolean   @default(true)
  isLocked          Boolean   @default(false)
  failCount         Int       @default(0)
  lockedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  profile Profile @relation(fields: [profileId], references: [id])

  @@unique([tenantId, loginId])
  @@unique([tenantId, popPinFingerprint])
  @@index([tenantId])
}

model LoginHistory {
  id         String           @id @default(cuid())
  tenantId   String
  loginId    String
  profileId  String?
  eventType  LoginEventType
  failReason LoginFailReason?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime         @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  profile Profile? @relation(fields: [profileId], references: [id])

  @@index([tenantId])
  @@index([profileId])
  @@index([loginId, createdAt])
}

// ─── Support Request ──────────────────────────────────────────────────────────

model SupportRequest {
  id          String          @id @default(cuid())
  tenantId    String
  authorId    String
  type        SupportType
  priority    SupportPriority @default(NORMAL)
  title       String
  content     String          @db.Text
  status      SupportStatus   @default(OPEN)
  imageUrl    String?
  answer      String?         @db.Text
  adminNote   String?         @db.Text
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  author    Profile  @relation("SupportAuthor", fields: [authorId], references: [id])
  handledBy Profile? @relation("SupportHandler", fields: [handledById], references: [id])

  @@index([tenantId])
  @@index([authorId])
  @@index([status])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// ─── NCWatch 설비 연동 ────────────────────────────────────────────────────────

// NCWatch 기계명 ↔ MES Equipment.id 매핑
model NcwatchEquipmentMapping {
  id          String   @id @default(cuid())
  tenantId    String
  siteId      String?
  machineName String   @map("machine_name")
  equipmentId String?  @map("equipment_id")
  isActive    Boolean  @default(true) @map("is_active")
  memo        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  equipment Equipment? @relation("EquipmentNcwatchMappings", fields: [equipmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, machineName])
  @@index([equipmentId])
  @@map("ncwatch_equipment_mapping")
}

// NCWatch 기계별 현재 상태 (10초마다 upsert, 기계당 1행)
model NcwatchStatus {
  id           String   @id @default(cuid())
  tenantId     String
  siteId       String?
  machineName  String   @map("machine_name")
  statusCode   Int?     @map("status_code")
  statusLabel  String?  @map("status_label")
  runCode      Int?     @map("run_code")
  modeCode     Int?     @map("mode_code")
  messageCode  Int?     @map("message_code")
  programName  String?  @map("program_name")
  oNumber      String?  @map("o_number")
  spindleSpeed Int?     @map("spindle_speed")
  feedRate     Int?     @map("feed_rate")
  positionX    Decimal? @map("position_x") @db.Decimal(18, 4)
  positionY    Decimal? @map("position_y") @db.Decimal(18, 4)
  positionZ    Decimal? @map("position_z") @db.Decimal(18, 4)
  toolNo       String?  @map("tool_no")
  partCount    Int?     @map("part_count")
  blockNumber  Int?     @map("block_number")
  blockTot     Int?     @map("block_tot")
  ratio        Decimal? @db.Decimal(5, 2)
  alarmCode    String?  @map("alarm_code")
  alarmMessage String?  @map("alarm_message")
  aliveCount   Int?     @map("alive_count")
  ncwatchTs    String?  @map("ncwatch_ts")
  rawPayload   Json?    @map("raw_payload")
  receivedAt   DateTime @default(now()) @map("received_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, machineName])
  @@index([machineName])
  @@map("ncwatch_status")
}

// NCWatch 상태 변경 이력 (statusCode 변경 시 append)
model NcwatchStatusHistory {
  id           String   @id @default(cuid())
  tenantId     String
  machineName  String   @map("machine_name")
  statusCode   Int?     @map("status_code")
  statusLabel  String?  @map("status_label")
  partCount    Int?     @map("part_count")
  spindleSpeed Int?     @map("spindle_speed")
  alarmMessage String?  @map("alarm_message")
  changedAt    DateTime @map("changed_at")
  receivedAt   DateTime @default(now()) @map("received_at")

  @@index([tenantId, machineName, changedAt])
  @@map("ncwatch_status_history")
}

// NCWatch 일간 가동 리포트 (기계+날짜 upsert, 1시간마다)
model NcwatchReportDaily {
  id          String   @id @default(cuid())
  tenantId    String
  machineName String   @map("machine_name")
  reportDate  DateTime @map("report_date") @db.Date
  runTime     String?  @map("run_time")
  runPct      Decimal? @map("run_pct") @db.Decimal(5, 2)
  partCount   Int?     @map("part_count")
  stopTime    String?  @map("stop_time")
  stopPct     Decimal? @map("stop_pct") @db.Decimal(5, 2)
  manualPct   Decimal? @map("manual_pct") @db.Decimal(5, 2)
  alarmPct    Decimal? @map("alarm_pct") @db.Decimal(5, 2)
  offlinePct  Decimal? @map("offline_pct") @db.Decimal(5, 2)
  manualTime  String?  @map("manual_time")
  alarmTime   String?  @map("alarm_time")
  offlineTime String?  @map("offline_time")
  rawPayload  Json?    @map("raw_payload")
  receivedAt  DateTime @default(now()) @map("received_at")

  @@unique([tenantId, machineName, reportDate])
  @@map("ncwatch_report_daily")
}

// NCWatch 수신/변환 로그
model NcwatchSyncLog {
  id           String   @id @default(cuid())
  tenantId     String
  machineName  String?  @map("machine_name")
  endpoint     String
  result       String
  message      String?
  payloadCount Int?     @map("payload_count")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([result])
  @@map("ncwatch_sync_log")
}
