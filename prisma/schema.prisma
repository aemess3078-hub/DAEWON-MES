// ─── 청운커팅 사업계획서 "첨부파일관리" ──────────────────────────────────────
//
// 여러 업무 엔티티(조치관리/재발방지관리, 향후 품목/수주/작업지시/설비/공구/
// 프로젝트 등으로 확대 예정)에 파일을 첨부하는 공통 구조다. 기존 Document/
// DocumentLink(work-standards 전용 문서 코드 마스터 — fileUrl은 수동 입력 링크일
// 뿐이고 fileSize/mimeType/업로더/업로드일시 등 실제 업로드 메타데이터가 없음)와는
// 근본적으로 목적이 달라 재사용하지 않고 신규로 만든다. 다만 하나의 모델이 여러
// 업무 엔티티에 연결되는 구조 자체는 DocumentLink(targetType/targetId 문자열 기반
// polymorphic 연결)와 동일한 패턴을 그대로 따른다 — Prisma FK 참조무결성을
// entityId에 대해서는 강제하지 못하는 대가를 감수하는 대신, 대상 엔티티 종류가
// 계속 늘어날 예정이라 매번 스키마 마이그레이션 없이 확장 가능해야 하기 때문이다.
// entityType은 Prisma enum이 아닌 문자열로 두고(DocumentLink.targetType과 동일
// 이유), 허용값은 애플리케이션 레벨 allow-list로 관리한다(attachment.helpers.ts의
// ATTACHMENT_ENTITY_TYPES). 서버의 모든 mutating/조회 action은 entityId가 가리키는
// 실제 레코드가 현재 tenant 소속인지 반드시 재검증한다(추측성 신뢰 금지).
//
// 실제 파일 바이너리는 DB에 저장하지 않는다 — Supabase Storage 비공개(private)
// 버킷에 저장하고, DB에는 metadata + storagePath만 저장한다. storagePath를 그대로
// 브라우저에 노출하지 않고, 다운로드 시 서버에서 tenant 소유권을 확인한 뒤 짧은
// 유효시간의 signed URL을 발급한다(attachment.actions.ts 참조). 삭제는 제공하되
// (사업계획서 CRUD 요구사항), 복잡한 버전관리/승인/전자서명은 이번 PR 범위 밖이다.
model Attachment {
  id         String @id @default(cuid())
  tenantId   String
  entityType String
  entityId   String

  fileName    String
  storagePath String
  mimeType    String
  fileSize    Int
  description String?

  uploadedById String
  createdAt    DateTime @default(now())

  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  uploadedBy Profile @relation(fields: [uploadedById], references: [id])

  @@unique([storagePath])
  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([uploadedById])
}

// ─── 청운커팅 사업계획서 "기준정보관리 > 백업관리" ──────────────────────────
//
// 이 기능은 NMES가 DB 백업을 직접 생성/수정/삭제하는 기능이 아니다 — 실제 DB
// 백업은 계속 Supabase가 자동으로 관리한다(Supabase Management API
// GET /v1/projects/{ref}/database/backups로 조회만 함, src/lib/supabase-management/
// backups.ts 참조). NMES는 그 백업 목록을 (1) 사용자가 그룹(폴더)으로 묶어
// 조회하고, (2) 특정 백업을 화면에서만 숨기는 "관리/분류 UI" 역할만 한다.
// Supabase backup 원본에 대한 mutation(생성/삭제/restore/PITR)은 이 코드베이스
// 어디에도 구현하지 않는다.
//
// 그룹-백업 관계는 M:N이다(같은 Supabase backup이 여러 그룹에 동시에 포함될 수
// 있음, § STEP 9). externalBackupId는 Supabase API 응답의 안정적인 식별자를
// 그대로 문자열로 보존한다(실제 응답에 id 필드가 있으면 그 값을, 없으면
// inserted_at을 사용 — backup.helpers.ts의 normalizeExternalBackupId 참조).
// Supabase 프로젝트가 tenant마다 별도가 아니라 하나이므로 백업 목록 자체는
// 모든 tenant에 동일하게 보이지만, 그룹/숨김 metadata는 tenant별로 분리한다
// (§ STEP 25).
model BackupGroup {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  description String?

  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  createdBy Profile           @relation("BackupGroupCreator", fields: [createdById], references: [id])
  updatedBy Profile           @relation("BackupGroupUpdater", fields: [updatedById], references: [id])
  items     BackupGroupItem[]

  @@index([tenantId])
}

// 그룹 삭제 시 이 관계 row들만 함께 정리한다(onDelete: Cascade) — Supabase backup
// 원본이나 다른 그룹에 속한 동일 backup의 멤버십에는 영향 없음.
model BackupGroupItem {
  id               String @id @default(cuid())
  tenantId         String
  groupId          String
  externalBackupId String

  backupAt  DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  group  BackupGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, externalBackupId])
  @@index([tenantId])
  @@index([externalBackupId])
}

// 특정 backup을 NMES 화면에서만 제외하는 용도 — Supabase backup 원본에는 어떤
// 영향도 주지 않는다. 그룹 소속 여부와 무관하게 독립적으로 존재한다(§ STEP 15).
model HiddenBackup {
  id               String @id @default(cuid())
  tenantId         String
  externalBackupId String

  hiddenById String
  hiddenAt   DateTime @default(now())

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  hiddenBy Profile @relation("HiddenBackupHider", fields: [hiddenById], references: [id])

  @@unique([tenantId, externalBackupId])
  @@index([tenantId])
  @@index([externalBackupId])
}

model WorkOrder {
  id              String          @id @default(cuid())
  tenantId        String
  siteId          String
  itemId          String
  bomId           String
  routingId       String
  orderNo         String
  manufacturingNo String?
  plannedQty      Decimal         @db.Decimal(18, 6)
  status          WorkOrderStatus @default(DRAFT)
  dueDate         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  site    Site    @relation(fields: [siteId], references: [id])
  item    Item    @relation(fields: [itemId], references: [id])
  bom     BOM     @relation(fields: [bomId], references: [id])
  routing Routing @relation(fields: [routingId], references: [id])

  productionPlanItemId String?
  productionPlanItem   ProductionPlanItem? @relation(fields: [productionPlanItemId], references: [id])

  operations            WorkOrderOperation[]
  materialReservations  MaterialReservation[]
  finishedGoodsReceipts FinishedGoodsReceipt[]
  itemCosts             ItemCost[]             @relation("WorkOrderItemCosts")
  materialLots          WorkOrderMaterialLot[]
  wipUnits              WipUnit[]

  @@unique([tenantId, orderNo])
  @@unique([tenantId, manufacturingNo])
  @@index([tenantId])
  @@index([siteId])
  @@index([status])
  @@index([tenantId, siteId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, itemId])
  @@index([productionPlanItemId])
  @@index([tenantId, manufacturingNo])
}

// ─── 의료기기 추적성: 작업지시-제조번호-원자재 LOT 연결 ─────────────────────
model WorkOrderMaterialLot {
  id                     String   @id @default(cuid())
  tenantId               String
  workOrderId            String
  manufacturingNo        String?
  materialItemId         String
  materialLotNo          String
  qty                    Decimal  @db.Decimal(18, 6)
  unit                   String?
  issuedAt               DateTime @default(now())
  issuedBy               String?
  inventoryTransactionId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workOrder            WorkOrder             @relation(fields: [workOrderId], references: [id])
  materialItem         Item                  @relation("MaterialLotItem", fields: [materialItemId], references: [id])
  inventoryTransaction InventoryTransaction? @relation("MaterialLotInventoryTx", fields: [inventoryTransactionId], references: [id])
  wipUnitMaterialLots  WipUnitMaterialLot[]

  @@index([tenantId])
  @@index([workOrderId])
  @@index([tenantId, manufacturingNo])
  @@index([materialItemId])
  @@index([tenantId, materialLotNo])
  @@index([inventoryTransactionId])
}

model WorkOrderOperation {
  id                 String          @id @default(cuid())
  workOrderId        String
  routingOperationId String
  equipmentId        String?
  seq                Int
  status             OperationStatus @default(PENDING)
  plannedQty         Decimal         @db.Decimal(18, 6)
  completedQty       Decimal         @default(0) @db.Decimal(18, 6)
  startedAt          DateTime?

  workOrder        WorkOrder        @relation(fields: [workOrderId], references: [id])
  routingOperation RoutingOperation @relation(fields: [routingOperationId], references: [id])
  equipment        Equipment?       @relation(fields: [equipmentId], references: [id])

  materialConsumptions    MaterialConsumption[]
  wipUnits                WipUnit[]
  productionResults       ProductionResult[]
  qualityInspections      QualityInspection[]
  wipMovementsFrom        WipMovement[]                  @relation("WipMovementFromOperation")
  wipMovementsTo          WipMovement[]                  @relation("WipMovementToOperation")
  assignments             WorkOrderOperationAssignment[]
  equipmentUsageHistories EquipmentUsageHistory[]
  purchaseOrderItems      PurchaseOrderItem[]            @relation("OutsourcingOperationPurchaseItems")

  @@unique([workOrderId, seq])
  @@index([workOrderId])
  @@index([routingOperationId])
  @@index([equipmentId])
}

model WorkOrderOperationAssignment {
  id                   String          @id @default(cuid())
  tenantId             String
  workOrderOperationId String
  equipmentId          String
  assignedQty          Decimal         @db.Decimal(18, 6)
  completedQty         Decimal         @default(0) @db.Decimal(18, 6)
  status               OperationStatus @default(PENDING)
  startedAt            DateTime?
  seq                  Int             @default(1)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  workOrderOperation WorkOrderOperation @relation(fields: [workOrderOperationId], references: [id], onDelete: Cascade)
  equipment          Equipment          @relation(fields: [equipmentId], references: [id])
  productionResults  ProductionResult[]

  @@unique([workOrderOperationId, equipmentId])
  @@index([tenantId])
  @@index([workOrderOperationId])
  @@index([equipmentId])
  @@index([status])
}

model MaterialReservation {
  id          String            @id @default(cuid())
  workOrderId String
  itemId      String
  requiredQty Decimal           @db.Decimal(18, 6)
  reservedQty Decimal           @default(0) @db.Decimal(18, 6)
  issuedQty   Decimal           @default(0) @db.Decimal(18, 6)
  status      ReservationStatus @default(PENDING)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])

  @@unique([workOrderId, itemId])
  @@index([workOrderId])
  @@index([itemId])
}

model Lot {
  id              String    @id @default(cuid())
  tenantId        String
  itemId          String
  lotNo           String
  status          LotStatus @default(ACTIVE)
  manufactureDate DateTime?
  expiryDate      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  inventoryBalances     InventoryBalance[]
  inventoryTxns         InventoryTransaction[]
  materialConsumptions  MaterialConsumption[]
  wipUnits              WipUnit[]
  wipUnitMaterialLots   WipUnitMaterialLot[]   @relation("WipUnitMaterialLot")
  finishedGoodsReceipts FinishedGoodsReceipt[]
  qualityInspections    QualityInspection[]
  parentGenealogyLinks  LotGenealogy[]         @relation("ParentLot")
  childGenealogyLinks   LotGenealogy[]         @relation("ChildLot")
  shipmentItems         ShipmentItem[]         @relation("LotShipmentItems")
  materialReturnItems   MaterialReturnItem[]

  @@unique([tenantId, lotNo])
  @@index([tenantId])
  @@index([itemId])
}

// 자재입고 자동채번 미리보기(라벨 선출력용) — 실제 Lot 생성 전 번호를 선점한다.
// RELEASED/EXPIRED 상태가 되어도 row는 삭제하지 않고 lotNo unique 제약으로 영구히 재사용을 막는다.
model LotNumberReservation {
  id                  String               @id @default(cuid())
  tenantId            String
  itemId              String
  purchaseOrderId     String
  purchaseOrderItemId String
  lotNo               String
  status              LotReservationStatus @default(RESERVED)
  reservedBy          String
  expiresAt           DateTime
  createdAt           DateTime             @default(now())
  consumedAt          DateTime?
  releasedAt          DateTime?
  // 라벨을 실제로 출력한 시각. null이면 "미출력" — 취소/재채번/만료 시 행을 삭제해 번호를 재사용 가능하게 한다.
  // 값이 있으면 "출력됨" — 이후 취소/재채번/만료돼도 행을 삭제하지 않고 상태만 바꿔 번호를 영구히 재사용 금지한다.
  printedAt           DateTime?

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  item              Item              @relation(fields: [itemId], references: [id])
  purchaseOrder     PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@unique([tenantId, lotNo])
  @@index([tenantId, purchaseOrderItemId])
  @@index([status, expiresAt])
}

model InventoryBalance {
  id           String   @id @default(cuid())
  tenantId     String
  siteId       String
  itemId       String
  lotId        String?
  warehouseId  String
  qtyOnHand    Decimal  @default(0) @db.Decimal(18, 6)
  qtyAvailable Decimal  @default(0) @db.Decimal(18, 6)
  qtyHold      Decimal  @default(0) @db.Decimal(18, 6)
  updatedAt    DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  site      Site      @relation(fields: [siteId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  lot       Lot?      @relation(fields: [lotId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, itemId, warehouseId, lotId])
  @@index([tenantId])
  @@index([siteId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([tenantId, siteId, itemId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, itemId, lotId, warehouseId])
}

model InventoryTransaction {
  id             String          @id @default(cuid())
  tenantId       String
  itemId         String
  lotId          String?
  fromLocationId String?
  toLocationId   String?
  txNo           String
  txType         TransactionType
  qty            Decimal         @db.Decimal(18, 6)
  refType        String?
  refId          String?
  note           String?
  txAt           DateTime        @default(now())

  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  item                  Item                   @relation(fields: [itemId], references: [id])
  lot                   Lot?                   @relation(fields: [lotId], references: [id])
  fromLocation          Warehouse?             @relation("TxFromWarehouse", fields: [fromLocationId], references: [id])
  toLocation            Warehouse?             @relation("TxToWarehouse", fields: [toLocationId], references: [id])
  workOrderMaterialLots WorkOrderMaterialLot[] @relation("MaterialLotInventoryTx")
  materialReturnItem    MaterialReturnItem?

  @@unique([tenantId, txNo])
  @@index([tenantId])
  @@index([itemId])
  @@index([lotId])
  @@index([txType])
  @@index([txAt])
  @@index([tenantId, txAt])
  @@index([tenantId, itemId, txAt])
  @@index([tenantId, refType, refId])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model MaterialConsumption {
  id                   String  @id @default(cuid())
  workOrderOperationId String
  itemId               String
  lotId                String?
  consumedQty          Decimal @db.Decimal(18, 6)
  scrapQty             Decimal @default(0) @db.Decimal(18, 6)

  workOrderOperation WorkOrderOperation @relation(fields: [workOrderOperationId], references: [id])
  item               Item               @relation(fields: [itemId], references: [id])
  lot                Lot?               @relation(fields: [lotId], references: [id])

  @@index([workOrderOperationId])
  @@index([itemId])
  @@index([lotId])
}

model WipUnit {
  id                       String        @id @default(cuid())
  tenantId                 String
  siteId                   String?
  workOrderId              String?
  workOrderOperationId     String
  itemId                   String
  lotId                    String?
  manufacturingNo          String?
  currentWorkCenterId      String?
  currentWarehouseId       String?
  currentLocationId        String?
  outsourcingPartnerId     String?
  sourceProductionResultId String?
  parentWipUnitId          String?
  qty                      Decimal       @db.Decimal(18, 6)
  status                   WipUnitStatus @default(IN_PROCESS)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  tenant                 Tenant               @relation(fields: [tenantId], references: [id])
  site                   Site?                @relation(fields: [siteId], references: [id])
  workOrder              WorkOrder?           @relation(fields: [workOrderId], references: [id])
  workOrderOperation     WorkOrderOperation   @relation(fields: [workOrderOperationId], references: [id])
  item                   Item                 @relation(fields: [itemId], references: [id])
  lot                    Lot?                 @relation(fields: [lotId], references: [id])
  currentLocation        Location?            @relation(fields: [currentLocationId], references: [id])
  currentWorkCenter      WorkCenter?          @relation("WipUnitCurrentWorkCenter", fields: [currentWorkCenterId], references: [id])
  currentWarehouse       Warehouse?           @relation("WipUnitCurrentWarehouse", fields: [currentWarehouseId], references: [id])
  outsourcingPartner     BusinessPartner?     @relation("WipUnitOutsourcingPartner", fields: [outsourcingPartnerId], references: [id])
  sourceProductionResult ProductionResult?    @relation("WipUnitSourceProductionResult", fields: [sourceProductionResultId], references: [id])
  parentWipUnit          WipUnit?             @relation("WipUnitLineage", fields: [parentWipUnitId], references: [id])
  childWipUnits          WipUnit[]            @relation("WipUnitLineage")
  movements              WipMovement[]        @relation("WipUnitMovements")
  relatedMovements       WipMovement[]        @relation("WipMovementRelatedWipUnit")
  materialLots           WipUnitMaterialLot[]
  holds                  WipHold[]

  @@index([tenantId, workOrderId])
  @@index([tenantId, manufacturingNo])
  @@index([tenantId, workOrderOperationId])
  @@index([tenantId, status])
  @@index([tenantId, currentLocationId])
  @@index([tenantId, currentWorkCenterId])
  @@index([tenantId, currentWarehouseId])
  @@index([tenantId, outsourcingPartnerId])
  @@index([tenantId, lotId])
  @@index([workOrderOperationId])
  @@index([itemId])
  @@index([lotId])
  @@index([currentLocationId])
  @@index([status])
  @@index([currentLocationId, status])
}

model WipMovement {
  id               String          @id @default(cuid())
  tenantId         String
  siteId           String?
  wipUnitId        String
  movementType     WipMovementType
  fromOperationId  String?
  toOperationId    String?
  fromWorkCenterId String?
  toWorkCenterId   String?
  fromWarehouseId  String?
  toWarehouseId    String?
  fromLocationId   String?
  toLocationId     String?
  fromPartnerId    String?
  toPartnerId      String?
  relatedWipUnitId String?
  qty              Decimal         @db.Decimal(18, 6)
  sourceType       String?
  sourceId         String?
  note             String?
  createdById      String?
  createdAt        DateTime        @default(now())

  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  site           Site?               @relation(fields: [siteId], references: [id])
  wipUnit        WipUnit             @relation("WipUnitMovements", fields: [wipUnitId], references: [id])
  fromOperation  WorkOrderOperation? @relation("WipMovementFromOperation", fields: [fromOperationId], references: [id])
  toOperation    WorkOrderOperation? @relation("WipMovementToOperation", fields: [toOperationId], references: [id])
  fromWorkCenter WorkCenter?         @relation("WipMovementFromWorkCenter", fields: [fromWorkCenterId], references: [id])
  toWorkCenter   WorkCenter?         @relation("WipMovementToWorkCenter", fields: [toWorkCenterId], references: [id])
  fromWarehouse  Warehouse?          @relation("WipMovementFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse    Warehouse?          @relation("WipMovementToWarehouse", fields: [toWarehouseId], references: [id])
  fromLocation   Location?           @relation("WipMovementFromLocation", fields: [fromLocationId], references: [id])
  toLocation     Location?           @relation("WipMovementToLocation", fields: [toLocationId], references: [id])
  fromPartner    BusinessPartner?    @relation("WipMovementFromPartner", fields: [fromPartnerId], references: [id])
  toPartner      BusinessPartner?    @relation("WipMovementToPartner", fields: [toPartnerId], references: [id])
  relatedWipUnit WipUnit?            @relation("WipMovementRelatedWipUnit", fields: [relatedWipUnitId], references: [id])

  @@index([tenantId, wipUnitId])
  @@index([tenantId, movementType])
  @@index([tenantId, createdAt])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, fromOperationId])
  @@index([tenantId, toOperationId])
  @@index([tenantId, relatedWipUnitId])
}

model WipUnitMaterialLot {
  id                     String   @id @default(cuid())
  tenantId               String
  wipUnitId              String
  workOrderMaterialLotId String?
  materialItemId         String
  materialLotId          String?
  materialLotNo          String?
  qty                    Decimal  @db.Decimal(18, 6)
  unit                   String?
  linkedAt               DateTime @default(now())

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  wipUnit              WipUnit               @relation(fields: [wipUnitId], references: [id])
  workOrderMaterialLot WorkOrderMaterialLot? @relation(fields: [workOrderMaterialLotId], references: [id])
  materialItem         Item                  @relation("WipUnitMaterialItem", fields: [materialItemId], references: [id])
  materialLot          Lot?                  @relation("WipUnitMaterialLot", fields: [materialLotId], references: [id])

  @@index([tenantId, wipUnitId])
  @@index([tenantId, workOrderMaterialLotId])
  @@index([tenantId, materialItemId])
  @@index([tenantId, materialLotId])
  @@index([tenantId, materialLotNo])
}

// 청운커팅 사업계획서 "재작업/보류관리" — 보류(ON_HOLD) 등록·해제·취소 이력.
// REWORK(불량 재작업, WipUnit.status=REWORK)와는 완전히 별개 흐름이며, 이 모델은
// dispositionDefects/completeRework의 책임(재작업 종결)을 절대 건드리지 않는다.
// 진행 방식은 WipMovement(HOLD/RELEASED movementType)로도 표현 가능하지만, "누가 어떤
// 사유로/어떤 이전상태에서 보류했고 언제 해제·취소됐는지"를 조회 가능한 형태로 추적하려면
// WipMovement 단독으로는 부족해 이 모델을 별도로 둔다(WipMovement는 이 모델의 액션마다
// 보조적으로 함께 기록해 LOT 추적 화면의 이동이력에도 노출되게 한다).
model WipHold {
  id              String        @id @default(cuid())
  tenantId        String
  siteId          String?
  wipUnitId       String
  previousStatus  WipUnitStatus
  status          WipHoldStatus @default(ACTIVE)
  reason          String
  note            String?
  heldAt          DateTime      @default(now())
  heldById        String?
  heldByName      String?
  releasedAt      DateTime?
  releasedById    String?
  releasedByName  String?
  releaseNote     String?
  cancelledAt     DateTime?
  cancelledById   String?
  cancelledByName String?
  cancelNote      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  site    Site?   @relation(fields: [siteId], references: [id])
  wipUnit WipUnit @relation(fields: [wipUnitId], references: [id])

  @@index([tenantId, wipUnitId])
  @@index([tenantId, status])
  @@index([wipUnitId, status])
  @@index([tenantId, heldAt])
}

model ProductionResult {
  id                             String    @id @default(cuid())
  workOrderOperationId           String
  workOrderOperationAssignmentId String?
  goodQty                        Decimal   @default(0) @db.Decimal(18, 6)
  defectQty                      Decimal   @default(0) @db.Decimal(18, 6)
  reworkQty                      Decimal   @default(0) @db.Decimal(18, 6)
  startedAt                      DateTime?
  endedAt                        DateTime?
  operatorId                     String?

  workOrderOperation           WorkOrderOperation            @relation(fields: [workOrderOperationId], references: [id])
  workOrderOperationAssignment WorkOrderOperationAssignment? @relation(fields: [workOrderOperationAssignmentId], references: [id])
  sourceWipUnits               WipUnit[]                     @relation("WipUnitSourceProductionResult")
  operator                     Profile?                      @relation("ProductionResultOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  equipmentUsageHistories      EquipmentUsageHistory[]

  @@index([workOrderOperationId])
  @@index([workOrderOperationAssignmentId])
  @@index([operatorId])
}

model FinishedGoodsReceipt {
  id          String   @id @default(cuid())
  tenantId    String
  siteId      String
  workOrderId String
  itemId      String
  lotId       String?
  warehouseId String
  locationId  String
  receiptQty  Decimal  @db.Decimal(18, 6)
  receiptAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  site      Site      @relation(fields: [siteId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  lot       Lot?      @relation(fields: [lotId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id])

  @@index([tenantId])
  @@index([siteId])
  @@index([workOrderId])
  @@index([itemId])
  @@index([lotId])
  @@index([tenantId, siteId, receiptAt])
  @@index([warehouseId, locationId])
}

enum InspectionStage {
  FIRST
  MID
  FINAL
}

model QualityInspection {
  id                   String            @id @default(cuid())
  workOrderOperationId String
  inspectionSpecId     String
  inspectorId          String
  stage                InspectionStage   @default(MID)
  result               InspectionResult?
  inspectedQty         Decimal           @db.Decimal(18, 6)
  inspectedAt          DateTime          @default(now())
  lotId                String?

  workOrderOperation WorkOrderOperation @relation(fields: [workOrderOperationId], references: [id])
  inspectionSpec     InspectionSpec     @relation(fields: [inspectionSpecId], references: [id])
  inspector          Profile            @relation(fields: [inspectorId], references: [id])
  lot                Lot?               @relation(fields: [lotId], references: [id])

  defectRecords DefectRecord[]
  measurements  InspectionMeasurement[]

  @@index([workOrderOperationId])
  @@index([inspectionSpecId])
  @@index([inspectorId])
  @@index([lotId])
  @@index([lotId, inspectedAt])
  @@index([workOrderOperationId, inspectedAt])
  @@index([inspectorId, inspectedAt])
}

// ─── 청운커팅 사업계획서 "품질검사 > SPC 통계분석" 선행 PR(#53) ──────────────────
//
// SPC 계산/Profile/차트는 후속 PR(#54)에서 다룬다. 이번 PR은 그 전제조건인
// "검사항목별 실제 측정값 정본"만 구축한다 — QualityInspection은 검사 이벤트(건)
// 전체 판정만 갖고, InspectionItem은 규격(LSL/USL) 템플릿만 가질 뿐 실측값을
// 저장할 곳이 없었다(사업계획서 감사 결과 확인). 이 모델이 그 간극을 메운다.
//
// lowerLimitSnapshot/upperLimitSnapshot/itemNameSnapshot/inputTypeSnapshot/
// unitSnapshot: InspectionItem을 그대로 참조하지 않고 값을 복제해 두는 이유는
// upsertInspectionItems()가 항목을 deleteMany+createMany로 통째로 교체하는
// 기존 동작 때문이다(버전 개념과 무관하게 id/lowerLimit/upperLimit이 언제든
// 재생성될 수 있음). 과거 측정값의 판정 기준이 나중에 규격이 바뀌었다는 이유로
// 흔들리는 것을 막기 위해 측정 시점 값을 서버가 직접 스냅샷한다(quality.actions.ts
// createQualityInspection 참조). 이 스냅샷 때문에라도 사용 이력이 있는 항목은
// upsertInspectionItems/deleteInspectionItem에서 수정·삭제를 막는다(DB FK도
// RESTRICT로 동일 목적을 이중 보장).
model InspectionMeasurement {
  id                  String @id @default(cuid())
  tenantId            String
  qualityInspectionId String
  inspectionItemId    String
  sampleNo            Int    @default(1)

  numericValue Decimal? @db.Decimal(18, 6)
  textValue    String?
  booleanValue Boolean?

  lowerLimitSnapshot Decimal?            @db.Decimal(18, 6)
  upperLimitSnapshot Decimal?            @db.Decimal(18, 6)
  itemNameSnapshot   String
  inputTypeSnapshot  InspectionInputType
  unitSnapshot       String?

  judgement InspectionJudgement?

  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  qualityInspection QualityInspection @relation(fields: [qualityInspectionId], references: [id])
  inspectionItem    InspectionItem    @relation(fields: [inspectionItemId], references: [id])

  @@unique([qualityInspectionId, inspectionItemId, sampleNo])
  @@index([tenantId, measuredAt])
  @@index([tenantId, inspectionItemId, measuredAt])
  @@index([qualityInspectionId])
  @@index([inspectionItemId])
}

// ─── 청운커팅 사업계획서 "품질검사 > SPC 통계분석" (PR #54) ──────────────────
//
// SpcProfile은 "어떤 NUMERIC 검사항목을 SPC 관리도로 볼지"를 지정하는 메타데이터일
// 뿐, 통계 결과 자체를 저장하지 않는다 — 관리도/Cp·Cpk/Histogram은 항상
// InspectionMeasurement(numericValue/lowerLimitSnapshot/upperLimitSnapshot)를
// 원본으로 매번 재계산한다(spc-calculations.ts 참조). 규격이 나중에 바뀌어도
// 과거 계산 결과가 스냅샷과 다르게 흔들리지 않도록 하기 위함이며, PR #53에서
// 세운 "판정 기준은 항상 measurement 시점 snapshot" 원칙과 동일하다.
model SpcProfile {
  id               String              @id @default(cuid())
  tenantId         String
  inspectionItemId String
  name             String
  controlChartType SpcControlChartType @default(I_MR)
  isActive         Boolean             @default(true)
  createdById      String
  updatedById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  inspectionItem InspectionItem @relation(fields: [inspectionItemId], references: [id])
  createdBy      Profile        @relation("SpcProfileCreator", fields: [createdById], references: [id])
  updatedBy      Profile        @relation("SpcProfileUpdater", fields: [updatedById], references: [id])

  @@unique([tenantId, inspectionItemId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([inspectionItemId])
}

model DefectRecord {
  id                  String             @id @default(cuid())
  qualityInspectionId String
  defectCodeId        String
  qty                 Decimal            @db.Decimal(18, 6)
  severity            DefectSeverity     @default(MAJOR)
  disposition         DefectDisposition?

  qualityInspection     QualityInspection            @relation(fields: [qualityInspectionId], references: [id])
  defectCode            DefectCode                   @relation(fields: [defectCodeId], references: [id])
  causeAnalysis         DefectCauseAnalysis?
  correctiveActions     DefectCorrectiveAction[]
  recurrencePreventions DefectRecurrencePrevention[]

  @@index([qualityInspectionId])
  @@index([defectCodeId])
}

// ─── 청운커팅 사업계획서 "품질검사 > 원인분석" (PR #55) ──────────────────────
//
// DefectRecord 1건당 최대 1건의 원인분석만 존재한다(1:0..1, @unique(defectRecordId)).
// QualityInspection 단위나 별도 QualityIssue 상위 사건으로 앵커링하지 않는다 —
// 한 검사에 서로 다른 defectCode가 여러 건 섞여도(§ DefectRecord 주석 참조) 근본
// 원인은 불량 건마다 다를 수 있어, 가장 구체적인 단위인 DefectRecord에 붙인다.
// 통계 결과나 조치/재발방지 이력을 이 모델에 얹지 않는다 — "기록"은 이 row를
// 직접 update하고 AuditLog(entityType="DefectCauseAnalysis")로 변경 이력만 남긴다
// (SpcProfile과 동일 패턴, 별도 revision 테이블 없음).
model DefectCauseAnalysis {
  id             String @id @default(cuid())
  tenantId       String
  defectRecordId String @unique

  rootCause      String
  analysisDetail String?

  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  defectRecord DefectRecord @relation(fields: [defectRecordId], references: [id])
  createdBy    Profile      @relation("DefectCauseAnalysisCreator", fields: [createdById], references: [id])
  updatedBy    Profile      @relation("DefectCauseAnalysisUpdater", fields: [updatedById], references: [id])

  @@index([tenantId])
}

// ─── 청운커팅 사업계획서 "품질검사 > 조치관리" ──────────────────────────────
//
// 불량 발생 → 원인분석 → 조치 등록 → 담당자 지정 → 완료기한 관리 → 조치 진행
// → 조치 완료 흐름 중 "조치 등록 ~ 조치 완료" 구간을 담당한다. 재발방지관리
// (효과성 검증/재발 여부 평가/CAPA 종료판정)는 별도 기능으로 분리하며 이
// 모델에 필드를 얹지 않는다.
//
// DefectRecord 1건에 여러 조치가 있을 수 있어 1:N으로 둔다(원인분석과 달리
// @unique(defectRecordId) 없음). 원인분석(DefectCauseAnalysis)은 이 모델에서
// 참조만 하고 절대 수정하지 않는다 — 원인분석 수정은 기존 원인분석 화면에서만.
//
// 기한초과는 DB에 별도 컬럼/상태로 저장하지 않는다 — 조회 시점에
// `dueDate < today && status !== COMPLETED` 로 화면에서 계산한다.
// 삭제 기능은 제공하지 않는다(품질 추적성/감사 증빙 목적, DefectCauseAnalysis와
// 동일 정책) — 변경은 update와 상태전이만 가능하며 AuditLog에 이력을 남긴다.
model DefectCorrectiveAction {
  id             String @id @default(cuid())
  tenantId       String
  defectRecordId String

  actionContent String
  assigneeId    String?
  dueDate       DateTime

  status CorrectiveActionStatus @default(OPEN)

  completedAt    DateTime?
  completionNote String?

  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  defectRecord DefectRecord @relation(fields: [defectRecordId], references: [id])
  assignee     Profile?     @relation("DefectCorrectiveActionAssignee", fields: [assigneeId], references: [id])
  createdBy    Profile      @relation("DefectCorrectiveActionCreator", fields: [createdById], references: [id])
  updatedBy    Profile      @relation("DefectCorrectiveActionUpdater", fields: [updatedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([defectRecordId])
  @@index([assigneeId])
}

// ─── 청운커팅 사업계획서 "품질검사 > 재발방지관리" ──────────────────────────
//
// 불량 발생 → 원인분석 → 조치관리("현재 발생한 문제를 바로잡는 조치") →
// 재발방지관리("같은 원인으로 재발하지 않도록 표준/공정/점검/교육 등을
// 개선하고, 그 대책이 실제 효과가 있었는지 검증하는 단계") 흐름의 마지막
// 구간을 담당한다.
//
// DefectRecord 1건에 여러 재발방지 대책이 있을 수 있어 조치관리와 동일하게
// 1:N으로 둔다(@unique(defectRecordId) 없음). 원인분석/조치관리는 이 모델에서
// 참조만 하고 절대 수정하지 않는다 — 각각의 원본 화면에서만 관리한다.
// DefectCorrectiveAction으로의 FK는 두지 않는다 — 선행조건 확인은
// defectRecordId를 통해 원인분석/조치 존재 여부를 조회하는 것으로 충분하고,
// 화면 이동 편의만을 위한 FK는 만들지 않는다(§ actions 파일의
// assertRecurrencePreventionPrerequisites 참조).
//
// 상태는 "대책 수행"과 "효과성 검증"을 구분하기 위해 조치관리보다 한 단계
// 많다: OPEN(등록) → IN_PROGRESS(대책 수행 중) → VERIFYING(검증 중) →
// COMPLETED(효과 확인 및 종료). 효과성 검증 결과가 EFFECTIVE일 때만
// COMPLETED로 전이하며, 이때 completedAt을 서버에서 자동 기록한다.
// INEFFECTIVE면 COMPLETED로 전이하지 않고 IN_PROGRESS로 되돌려 추가 대책을
// 수행하게 한다 — 검증 이력은 최신 1건만 이 row에 스냅샷으로 보관한다(별도
// 이력 테이블 없음, DefectCauseAnalysis와 동일한 "단일 row 갱신 + AuditLog로
// 변경 이력 추적" 패턴).
//
// 기한초과는 DB에 별도 컬럼/상태로 저장하지 않는다 — 조치관리와 동일하게
// `dueDate < today && status !== COMPLETED`를 조회 시점에 계산한다.
// 삭제 기능은 제공하지 않는다(품질 추적성/감사 증빙 목적, DefectCauseAnalysis/
// DefectCorrectiveAction과 동일 정책) — 변경은 update와 상태전이만 가능하며
// AuditLog에 이력을 남긴다.
model DefectRecurrencePrevention {
  id             String @id @default(cuid())
  tenantId       String
  defectRecordId String

  preventionContent String
  assigneeId        String?
  dueDate           DateTime

  status RecurrencePreventionStatus @default(OPEN)

  verificationContent String?
  verificationResult  VerificationResult?
  verifierId          String?
  verifiedAt          DateTime?

  completedAt DateTime?

  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  defectRecord DefectRecord @relation(fields: [defectRecordId], references: [id])
  assignee     Profile?     @relation("DefectRecurrencePreventionAssignee", fields: [assigneeId], references: [id])
  verifier     Profile?     @relation("DefectRecurrencePreventionVerifier", fields: [verifierId], references: [id])
  createdBy    Profile      @relation("DefectRecurrencePreventionCreator", fields: [createdById], references: [id])
  updatedBy    Profile      @relation("DefectRecurrencePreventionUpdater", fields: [updatedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([defectRecordId])
  @@index([assigneeId])
}

model LotGenealogy {
  id           String               @id @default(cuid())
  parentLotId  String
  childLotId   String
  relationType LotGenealogyRelation @default(OUTPUT)
  qty          Decimal              @db.Decimal(18, 6)

  parentLot Lot @relation("ParentLot", fields: [parentLotId], references: [id])
  childLot  Lot @relation("ChildLot", fields: [childLotId], references: [id])

  @@unique([parentLotId, childLotId, relationType])
  @@index([parentLotId])
  @@index([childLotId])
}

model AuditLog {
  id         String         @id @default(cuid())
  tenantId   String
  actorId    String?
  actorType  AuditActorType @default(USER)
  actorLabel String?
  entityType String
  entityId   String
  action     AuditAction
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  menuName   String?
  actedAt    DateTime       @default(now())

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  actor  Profile? @relation(fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([actedAt])
  @@index([tenantId, entityType, entityId, actedAt])
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  tenantId    String
  requesterId String
  approverId  String?
  requestType String
  targetType  String
  targetId    String
  status      ApprovalStatus @default(PENDING)
  requestedAt DateTime       @default(now())
  approvedAt  DateTime?

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  requester Profile  @relation("Requester", fields: [requesterId], references: [id])
  approver  Profile? @relation("Approver", fields: [approverId], references: [id])

  @@index([tenantId])
  @@index([requesterId])
  @@index([approverId])
  @@index([status])
  @@index([status, requestedAt])
  @@index([tenantId, targetType, targetId])
}

model ProductionPlan {
  id        String     @id @default(cuid())
  tenantId  String
  siteId    String
  planNo    String
  planType  PlanType
  startDate DateTime
  endDate   DateTime
  status    PlanStatus @default(DRAFT)
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  site   Site                 @relation(fields: [siteId], references: [id])
  items  ProductionPlanItem[]

  @@unique([tenantId, planNo])
  @@index([tenantId])
  @@index([siteId])
  @@index([status])
}

model ProductionPlanItem {
  id         String  @id @default(cuid())
  planId     String
  itemId     String
  bomId      String?
  routingId  String?
  plannedQty Decimal @db.Decimal(18, 6)
  note       String?

  salesOrderItemId String?

  plan           ProductionPlan  @relation(fields: [planId], references: [id])
  item           Item            @relation(fields: [itemId], references: [id])
  bom            BOM?            @relation(fields: [bomId], references: [id])
  routing        Routing?        @relation(fields: [routingId], references: [id])
  workOrders     WorkOrder[]
  salesOrderItem SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])

  @@unique([planId, itemId])
  @@index([planId])
  @@index([itemId])
}

model CodeGroup {
  id          String   @id @default(cuid())
  tenantId    String
  groupCode   String
  groupName   String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  codes  CommonCode[]

  @@unique([tenantId, groupCode])
  @@index([tenantId])
}

model CommonCode {
  id           String   @id @default(cuid())
  groupId      String
  code         String
  name         String
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  extra        Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group CodeGroup @relation(fields: [groupId], references: [id])

  downtimeRecords EquipmentDowntime[] @relation("DowntimeReason")

  @@unique([groupId, code])
  @@index([groupId])
}

model RolePermission {
  id        String           @id @default(cuid())
  tenantId  String
  role      UserRole
  resource  String
  action    PermissionAction
  isAllowed Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, role, resource, action])
  @@index([tenantId])
  @@index([role])
  @@index([resource])
}

model FeatureDefinition {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  category     String
  icon         String?
  menuCodes    String[]
  isCore       Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dependencies   FeatureDependency[]  @relation("Feature")
  dependedBy     FeatureDependency[]  @relation("DependsOn")
  requirements   FeatureRequirement[]
  tenantFeatures TenantFeature[]
}

model FeatureDependency {
  id          String  @id @default(cuid())
  featureId   String
  dependsOnId String
  isRequired  Boolean @default(true)

  feature   FeatureDefinition @relation("Feature", fields: [featureId], references: [id])
  dependsOn FeatureDefinition @relation("DependsOn", fields: [dependsOnId], references: [id])

  @@unique([featureId, dependsOnId])
}

model FeatureRequirement {
  id          String  @id @default(cuid())
  featureId   String
  type        String
  target      String
  description String?

  feature FeatureDefinition @relation(fields: [featureId], references: [id])

  @@index([featureId])
}

model TenantFeature {
  id        String   @id @default(cuid())
  tenantId  String
  featureId String
  isEnabled Boolean  @default(true)
  enabledAt DateTime @default(now())
  config    Json?

  tenant  Tenant            @relation(fields: [tenantId], references: [id])
  feature FeatureDefinition @relation(fields: [featureId], references: [id])

  @@unique([tenantId, featureId])
  @@index([tenantId])
}

// ─── Equipment Integration ────────────────────────────────────────────────────

model EdgeGateway {
  id            String        @id @default(cuid())
  tenantId      String
  siteId        String
  name          String
  description   String?
  apiKey        String        @unique @default(cuid())
  status        GatewayStatus @default(OFFLINE)
  lastHeartbeat DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  site        Site                  @relation(fields: [siteId], references: [id])
  connections EquipmentConnection[]

  @@index([tenantId])
}

model EquipmentConnection {
  id          String             @id @default(cuid())
  equipmentId String
  gatewayId   String
  protocol    ConnectionProtocol
  host        String?
  port        Int?
  config      Json?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  equipment Equipment   @relation(fields: [equipmentId], references: [id])
  gateway   EdgeGateway @relation(fields: [gatewayId], references: [id])
  tags      DataTag[]

  @@unique([equipmentId, gatewayId])
}

model DataTag {
  id           String      @id @default(cuid())
  connectionId String
  tagCode      String
  displayName  String
  dataType     TagDataType
  unit         String?
  category     TagCategory
  plcAddress   String
  scaleFactor  Decimal?    @db.Decimal(18, 6)
  offset       Decimal?    @db.Decimal(18, 6)
  samplingMs   Int         @default(1000)
  deadband     Decimal?    @db.Decimal(18, 6)
  isActive     Boolean     @default(true)
  isEnabled    Boolean     @default(true) @map("is_enabled")
  isVisible    Boolean     @default(true) @map("is_visible")
  isPrimary    Boolean     @default(false) @map("is_primary")
  displayOrder Int         @default(0) @map("display_order")
  source       String?     @map("source")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  connection   EquipmentConnection @relation(fields: [connectionId], references: [id])
  snapshots    TagSnapshot[]
  currentValue TagCurrentValue?

  @@unique([connectionId, tagCode])
  @@index([connectionId])
