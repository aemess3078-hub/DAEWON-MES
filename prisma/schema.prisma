generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // 애플리케이션 런타임: Supabase Transaction Pooler(6543, pgbouncer=true)
  url       = env("DATABASE_URL")
  // Prisma Migrate(CLI) 전용: Session Pooler/Direct(5432). 트랜잭션 풀러는 migrate 의 advisory lock 등과 맞지 않는다.
  // PrismaClient 런타임은 이 값을 사용하지 않는다.
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

enum SiteType {
  FACTORY
  WAREHOUSE
  OFFICE
}

enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
}

enum ItemType {
  RAW_MATERIAL
  SEMI_FINISHED
  FINISHED
  CONSUMABLE
}

enum ItemStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum LotNumberingType {
  DEFAULT
  MANUAL
  RAW_DATE_SEQ
  PREFIX_MONTH_SEQ
}

enum ManualLotPolicy {
  ALLOWED
  REQUIRED
  DISABLED
}

enum UOM {
  EA
  KG
  G
  L
  ML
  M
  CM
  MM
  BOX
  SET
}

enum BOMStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum RoutingStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum RoutingScope {
  COMMON
  ITEM_SPECIFIC
}

enum WorkCenterKind {
  ASSEMBLY
  MACHINING
  INSPECTION
  PACKAGING
  STORAGE
}

enum EquipmentType {
  MACHINE
  TOOL
  JIG
  FIXTURE
  VEHICLE
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  // 청운커팅 사업계획서 "설비관리 > 공구관리" — 폐기된 공구/치공구를 나타낸다.
  // 기존 ACTIVE/INACTIVE/MAINTENANCE와 달리 되돌릴 수 없는 종료 상태로 취급한다
  // (tool.actions.ts에서 DISCARDED → 다른 상태로의 역행 전이를 차단).
  DISCARDED
}

enum WorkOrderStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OperationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum ReservationStatus {
  PENDING
  PARTIAL
  FULFILLED
  CANCELLED
}

enum LotStatus {
  ACTIVE
  QUARANTINE
  ON_HOLD
  CONSUMED
  EXPIRED
}

enum LotReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
  EXPIRED
}

enum TransactionType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUST
  RETURN
  SCRAP
  // 공급사 반품 전용(정상 입고되어 재고화된 자재를 공급사로 반품). 재고 방향은
  // outbound(-)다. 기존 RETURN(inbound, +재고)과는 의미가 반대이므로 별도 enum으로
  // 분리한다 — RETURN은 하위호환을 위해 절대 변경/재사용하지 않는다.
  SUPPLIER_RETURN
}

enum WipUnitStatus {
  WAITING
  IN_PROCESS
  ON_HOLD
  OUTSOURCED
  IN_TRANSIT
  RECEIVED
  COMPLETED
  SCRAPPED
  REWORK
}

enum WipMovementType {
  CREATED
  STARTED
  MOVED
  HOLD
  RELEASED
  SPLIT
  MERGE
  DEFECT
  REWORK
  SCRAP
  OUTSOURCED
  RETURNED
  COMPLETED
  ADJUSTED
}

// 청운커팅 사업계획서 "재작업/보류관리" — WipUnit.status=ON_HOLD 등록/해제/취소 이력의 상태.
// REWORK(불량 재작업)와는 별개 개념이다: ON_HOLD는 정상/진행 중 WIP을 업무상 일시 정지한 상태.
enum WipHoldStatus {
  ACTIVE
  RELEASED
  CANCELLED
}

enum InspectionResult {
  PASS
  FAIL
  CONDITIONAL
}

enum DefectSeverity {
  CRITICAL
  MAJOR
  MINOR
}

enum DefectDisposition {
  SCRAP
  REWORK
  ACCEPT
  USE_AS_IS
}

enum DefectCategory {
  DIMENSIONAL
  VISUAL
  FUNCTIONAL
  MATERIAL
}

// 청운커팅 사업계획서 "품질검사 > 조치관리" — 등록/진행/완료 3단계로 최소화한다.
// CANCELLED/REJECTED/APPROVED 등은 실제 필요성이 확인되기 전까지 추가하지 않는다.
enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

// 청운커팅 사업계획서 "품질검사 > 재발방지관리" — "대책 수행"과 "효과성 검증"을
// 구분해야 하므로 조치관리(3단계)보다 한 단계 많다. 효과성 검증 전에는
// COMPLETED가 될 수 없다(VERIFYING을 반드시 거친다).
enum RecurrencePreventionStatus {
  OPEN
  IN_PROGRESS
  VERIFYING
  COMPLETED
}

// 효과성 검증 결과. INEFFECTIVE면 COMPLETED로 전이하지 않고 IN_PROGRESS로
// 되돌려 추가 대책을 수행하게 한다(§ DefectRecurrencePrevention 주석 참조).
enum VerificationResult {
  EFFECTIVE
  INEFFECTIVE
}

enum DocType {
  SOP
  DRAWING
  SPEC
  CERTIFICATE
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum SignupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
}

enum InspectionInputType {
  NUMERIC
  TEXT
  BOOLEAN
  SELECT
}

enum LotGenealogyRelation {
  INPUT
  OUTPUT
  REWORK
}

enum InspectionSpecStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum InspectionJudgement {
  PASS
  FAIL
}

// 이번 PR은 Individuals-Moving Range만 지원한다 — P chart/Xbar-R 등은 후속 범위.
enum SpcControlChartType {
  I_MR
}

enum AuditActorType {
  USER
  SYSTEM
  BATCH
  API
}

enum PlanType {
  DAILY
  WEEKLY
  MONTHLY
}

enum PlanStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
  APPROVE
  EXPORT
}

enum ConnectionProtocol {
  OPC_UA
  MODBUS_TCP
  MQTT
  MC_PROTOCOL
  S7
  FOCAS
  CUSTOM
  NCWATCH_AGENT
}

enum TagDataType {
  BOOL
  INT
  FLOAT
  STRING
}

enum TagCategory {
  PROCESS
  STATUS
  ALARM
  COUNTER
  QUALITY
}

enum GatewayStatus {
  ONLINE
  OFFLINE
  ERROR
}

enum ECNStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
  IMPLEMENTED
  CANCELLED
}

enum EquipmentEventType {
  RUN
  STOP
  ALARM
  WARNING
  MAINTENANCE
}

enum LoginEventType {
  LOGIN_SUCCESS
  LOGIN_FAIL
  LOGOUT
}

enum LoginFailReason {
  USER_NOT_FOUND
  INVALID_PASSWORD
  PENDING_APPROVAL
  HOLD
  REJECTED
  INACTIVE
  LOCKED
  DELETED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  sites                         Site[]
  tenantUsers                   TenantUser[]
  businessPartners              BusinessPartner[]
  itemCategories                ItemCategory[]
  items                         Item[]
  warehouses                    Warehouse[]
  numberingRules                NumberingRule[]
  lots                          Lot[]
  lotNumberReservations         LotNumberReservation[]
  inventoryBalances             InventoryBalance[]
  inventoryTxns                 InventoryTransaction[]
  workOrders                    WorkOrder[]
  defectCodes                   DefectCode[]
  documents                     Document[]
  workStandardMappings          WorkStandardMapping[]
  inspectionSpecs               InspectionSpec[]
  auditLogs                     AuditLog[]
  approvalRequests              ApprovalRequest[]
  equipments                    Equipment[]
  finishedGoodsReceipts         FinishedGoodsReceipt[]
  wipUnits                      WipUnit[]
  wipMovements                  WipMovement[]
  wipUnitMaterialLots           WipUnitMaterialLot[]
  wipHolds                      WipHold[]
  boms                          BOM[]
  routings                      Routing[]
  itemRoutings                  ItemRouting[]
  productionPlans               ProductionPlan[]
  codeGroups                    CodeGroup[]
  rolePermissions               RolePermission[]
  tenantFeatures                TenantFeature[]
  gateways                      EdgeGateway[]
  salesOrders                   SalesOrder[]                   @relation("TenantSalesOrders")
  shipmentOrders                ShipmentOrder[]                @relation("TenantShipmentOrders")
  purchaseOrders                PurchaseOrder[]                @relation("TenantPurchaseOrders")
  itemPrices                    ItemPrice[]                    @relation("TenantItemPrices")
  itemSuppliers                 ItemSupplier[]                 @relation("TenantItemSuppliers")
  aiUsageLogs                   AIUsageLog[]                   @relation("TenantAIUsageLogs")
  quotations                    Quotation[]                    @relation("TenantQuotations")
  projectOrders                 ProjectOrder[]                 @relation("TenantProjectOrders")
  projectStages                 ProjectStage[]
  projectIssues                 ProjectIssue[]                 @relation("TenantProjectIssues")
  itemCosts                     ItemCost[]                     @relation("TenantItemCosts")
  engineeringChanges            EngineeringChange[]            @relation("TenantECNs")
  signupRequests                SignupRequest[]
  equipmentProblemTypes         EquipmentProblemType[]
  equipmentRepairs              EquipmentRepairRequest[]
  equipmentDailyChecks          EquipmentDailyCheck[]
  userCredentials               UserCredential[]
  loginHistories                LoginHistory[]
  itemGroups                    ItemGroup[]
  workOrderOperationAssignments WorkOrderOperationAssignment[]
  supportRequests               SupportRequest[]
  materialReturns               MaterialReturn[]
  projectOrderPrices            ProjectOrderPrice[]
  projectOrderPriceRevisions    ProjectOrderPriceRevision[]
  inspectionMeasurements        InspectionMeasurement[]
  spcProfiles                   SpcProfile[]
  defectCauseAnalyses           DefectCauseAnalysis[]
  defectCorrectiveActions       DefectCorrectiveAction[]
  defectRecurrencePreventions   DefectRecurrencePrevention[]
  equipmentUsageHistories       EquipmentUsageHistory[]
  attachments                   Attachment[]
  backupGroups                  BackupGroup[]
  backupGroupItems              BackupGroupItem[]
  hiddenBackups                 HiddenBackup[]
  EquipmentDowntime             EquipmentDowntime[]
  EquipmentMaintenancePlan      EquipmentMaintenancePlan[]
  EquipmentMaintenanceHistory   EquipmentMaintenanceHistory[]
}

model Profile {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  avatarUrl  String?
  department String?
  phone      String?
  employeeNo String?
  jobTitle   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenantUsers                         TenantUser[]
  qualityInspections                  QualityInspection[]
  auditLogs                           AuditLog[]
  approvalRequests                    ApprovalRequest[]             @relation("Requester")
  approvals                           ApprovalRequest[]             @relation("Approver")
  receivingInspections                ReceivingInspection[]         @relation("ReceivingInspector")
  ecnRequested                        EngineeringChange[]           @relation("ECNRequester")
  ecnApproved                         EngineeringChange[]           @relation("ECNApprover")
  signupsApproved                     SignupRequest[]               @relation("SignupApprover")
  signupsRejected                     SignupRequest[]               @relation("SignupRejector")
  repairRequested                     EquipmentRepairRequest[]      @relation("RepairRequester")
  repairAssigned                      EquipmentRepairRequest[]      @relation("RepairAssignee")
  dailyChecks                         EquipmentDailyCheck[]         @relation("DailyCheckChecker")
  userCredential                      UserCredential?
  loginHistories                      LoginHistory[]
  supportAuthored                     SupportRequest[]              @relation("SupportAuthor")
  supportHandled                      SupportRequest[]              @relation("SupportHandler")
  projectOrdersOwned                  ProjectOrder[]                @relation("ProjectOrderOwner")
  projectIssuesAssigned               ProjectIssue[]                @relation("ProjectIssueAssignee")
  projectIssuesCreated                ProjectIssue[]                @relation("ProjectIssueCreator")
  materialReturnsCreated              MaterialReturn[]              @relation("MaterialReturnCreator")
  materialReturnsCompleted            MaterialReturn[]              @relation("MaterialReturnCompleter")
  projectOrderPricesCreated           ProjectOrderPrice[]           @relation("ProjectOrderPriceCreator")
  projectOrderPricesUpdated           ProjectOrderPrice[]           @relation("ProjectOrderPriceUpdater")
  projectOrderPricesDecided           ProjectOrderPrice[]           @relation("ProjectOrderPriceDecider")
  projectOrderPriceRevisions          ProjectOrderPriceRevision[]   @relation("ProjectOrderPriceRevisionChanger")
  spcProfilesCreated                  SpcProfile[]                  @relation("SpcProfileCreator")
  spcProfilesUpdated                  SpcProfile[]                  @relation("SpcProfileUpdater")
  defectCauseAnalysesCreated          DefectCauseAnalysis[]         @relation("DefectCauseAnalysisCreator")
  defectCauseAnalysesUpdated          DefectCauseAnalysis[]         @relation("DefectCauseAnalysisUpdater")
  defectCorrectiveActionsAssigned     DefectCorrectiveAction[]      @relation("DefectCorrectiveActionAssignee")
  defectCorrectiveActionsCreated      DefectCorrectiveAction[]      @relation("DefectCorrectiveActionCreator")
  defectCorrectiveActionsUpdated      DefectCorrectiveAction[]      @relation("DefectCorrectiveActionUpdater")
  defectRecurrencePreventionsAssigned DefectRecurrencePrevention[]  @relation("DefectRecurrencePreventionAssignee")
  defectRecurrencePreventionsVerified DefectRecurrencePrevention[]  @relation("DefectRecurrencePreventionVerifier")
  defectRecurrencePreventionsCreated  DefectRecurrencePrevention[]  @relation("DefectRecurrencePreventionCreator")
  defectRecurrencePreventionsUpdated  DefectRecurrencePrevention[]  @relation("DefectRecurrencePreventionUpdater")
  equipmentUsageHistoriesAsOperator   EquipmentUsageHistory[]       @relation("EquipmentUsageOperator")
  equipmentUsageHistoriesCreated      EquipmentUsageHistory[]       @relation("EquipmentUsageCreator")
  createdDowntimeRecords              EquipmentDowntime[]           @relation("EquipmentDowntimeCreator")
  createdMaintenancePlans             EquipmentMaintenancePlan[]    @relation("EquipmentMaintenancePlanCreator")
  performedMaintenanceHistories       EquipmentMaintenanceHistory[] @relation("EquipmentMaintenancePerformer")
  productionResultsOperated           ProductionResult[]            @relation("ProductionResultOperator")
  attachmentsUploaded                 Attachment[]
  backupGroupsCreated                 BackupGroup[]                 @relation("BackupGroupCreator")
  backupGroupsUpdated                 BackupGroup[]                 @relation("BackupGroupUpdater")
  hiddenBackupsHidden                 HiddenBackup[]                @relation("HiddenBackupHider")
}

model Site {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  type      SiteType @default(FACTORY)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant                        @relation(fields: [tenantId], references: [id])
  tenantUsers           TenantUser[]
  workCenters           WorkCenter[]
  warehouses            Warehouse[]
  workOrders            WorkOrder[]
  inventoryBalances     InventoryBalance[]
  equipments            Equipment[]
  finishedGoodsReceipts FinishedGoodsReceipt[]
  wipUnits              WipUnit[]
  wipMovements          WipMovement[]
  wipHolds              WipHold[]
  productionPlans       ProductionPlan[]
  gateways              EdgeGateway[]
  salesOrders           SalesOrder[]                  @relation("SiteSalesOrders")
  shipmentOrders        ShipmentOrder[]               @relation("SiteShipmentOrders")
  purchaseOrders        PurchaseOrder[]               @relation("SitePurchaseOrders")
  quotations            Quotation[]                   @relation("SiteQuotations")
  projectOrders         ProjectOrder[]                @relation("SiteProjectOrders")
  equipmentRepairs      EquipmentRepairRequest[]
  equipmentDailyChecks  EquipmentDailyCheck[]
  equipmentDowntimes    EquipmentDowntime[]
  maintenancePlans      EquipmentMaintenancePlan[]
  maintenanceHistories  EquipmentMaintenanceHistory[]
  materialReturns       MaterialReturn[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  profileId String
  siteId    String?
  role      UserRole @default(OPERATOR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  profile Profile @relation(fields: [profileId], references: [id])
  site    Site?   @relation(fields: [siteId], references: [id])

  @@index([tenantId])
  @@index([profileId])
  @@index([siteId])
  @@index([tenantId, profileId])
  @@index([tenantId, siteId, role])
}

model SignupRequest {
  id                String              @id @default(cuid())
  tenantId          String
  loginId           String?
  email             String
  name              String
  department        String?
  employeeNo        String?
  phone             String?
  jobTitle          String?
  passwordHash      String?
  popPinHash        String?
  popPinFingerprint String?
  popPinSetAt       DateTime?
  requestedRole     UserRole            @default(OPERATOR)
  status            SignupRequestStatus @default(PENDING)
  createdAt         DateTime            @default(now())
  approvedAt        DateTime?
  approvedById      String?
  rejectedAt        DateTime?
  rejectedById      String?
  rejectReason      String?

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  approvedBy Profile? @relation("SignupApprover", fields: [approvedById], references: [id])
  rejectedBy Profile? @relation("SignupRejector", fields: [rejectedById], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([email])
  @@index([tenantId, loginId])
  @@index([tenantId, popPinFingerprint])
}

model WorkCenter {
  id        String         @id @default(cuid())
  siteId    String
  code      String
  name      String
  kind      WorkCenterKind @default(ASSEMBLY)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  site              Site               @relation(fields: [siteId], references: [id])
  equipments        Equipment[]
  routingOperations RoutingOperation[]
  currentWipUnits   WipUnit[]          @relation("WipUnitCurrentWorkCenter")
  wipMovementsFrom  WipMovement[]      @relation("WipMovementFromWorkCenter")
  wipMovementsTo    WipMovement[]      @relation("WipMovementToWorkCenter")

  @@unique([siteId, code])
  @@index([siteId])
}

model BusinessPartner {
  id          String        @id @default(cuid())
  tenantId    String
  code        String
  name        String
  partnerType PartnerType
  status      PartnerStatus @default(ACTIVE)

  // 연락처/상세 정보 (전부 선택, 기존 데이터는 null)
  businessNumber String? // 사업자등록번호
  ceoName        String? // 대표자명
  phone          String? // 전화번호
  email          String? // 이메일1 (대표 이메일)
  email2         String? // 이메일2 (담당자/추가 이메일)
  address        String? // 주소
  contactName    String? // 담당자명
  contactPhone   String? // 담당자연락처
  remark         String? // 비고

  tenant                  Tenant           @relation(fields: [tenantId], references: [id])
  salesOrders             SalesOrder[]     @relation("CustomerSalesOrders")
  purchaseOrders          PurchaseOrder[]  @relation("SupplierPurchaseOrders")
  itemPrices              ItemPrice[]      @relation("PartnerPrices")
  itemSuppliers           ItemSupplier[]   @relation("SupplierItemSuppliers")
  quotations              Quotation[]      @relation("CustomerQuotations")
  projectOrders           ProjectOrder[]   @relation("CustomerProjectOrders")
  outsourcedWipUnits      WipUnit[]        @relation("WipUnitOutsourcingPartner")
  wipMovementsFromPartner WipMovement[]    @relation("WipMovementFromPartner")
  wipMovementsToPartner   WipMovement[]    @relation("WipMovementToPartner")
  materialReturns         MaterialReturn[] @relation("SupplierMaterialReturns")

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ItemCategory {
  id           String    @id @default(cuid())
  tenantId     String
  parentId     String?
  code         String
  name         String
  itemType     ItemType?
  displayOrder Int       @default(0)

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  parent     ItemCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   ItemCategory[] @relation("CategoryTree")
  items      Item[]
  itemGroups ItemGroup[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
}

model ItemGroup {
  id           String   @id @default(cuid())
  tenantId     String
  categoryId   String
  code         String
  name         String
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  category ItemCategory @relation(fields: [categoryId], references: [id])
  items    Item[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([categoryId])
}

model Item {
  id                 String           @id @default(cuid())
  tenantId           String
  categoryId         String?
  itemGroupId        String?
  code               String
  name               String
  itemType           ItemType
  uom                UOM              @default(EA)
  spec               String?
  isLotTracked       Boolean          @default(false)
  isSerialTracked    Boolean          @default(false)
  lotNumberingType   LotNumberingType @default(DEFAULT)
  lotPrefix          String?
  manualLotPolicy    ManualLotPolicy  @default(ALLOWED)
  status             ItemStatus       @default(ACTIVE)
  defaultWarehouseId String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  category         ItemCategory? @relation(fields: [categoryId], references: [id])
  itemGroup        ItemGroup?    @relation(fields: [itemGroupId], references: [id])
  defaultWarehouse Warehouse?    @relation("ItemDefaultWarehouse", fields: [defaultWarehouseId], references: [id])

  substitutes             ItemSubstitute[]        @relation("PrimaryItem")
  substituteOf            ItemSubstitute[]        @relation("SubstituteItem")
  boms                    BOM[]
  bomItems                BOMItem[]
  itemRoutings            ItemRouting[]
  workStandardMappings    WorkStandardMapping[]
  lots                    Lot[]
  lotNumberReservations   LotNumberReservation[]
  inspectionSpecs         InspectionSpec[]
  inventoryBalances       InventoryBalance[]
  inventoryTxns           InventoryTransaction[]
  workOrders              WorkOrder[]
  materialReservations    MaterialReservation[]
  materialConsumptions    MaterialConsumption[]
  wipUnits                WipUnit[]
  wipUnitMaterialLots     WipUnitMaterialLot[]    @relation("WipUnitMaterialItem")
  finishedGoodsReceipts   FinishedGoodsReceipt[]
  productionPlanItems     ProductionPlanItem[]
  salesOrderItems         SalesOrderItem[]        @relation("ItemSalesOrderItems")
  shipmentItems           ShipmentItem[]          @relation("ItemShipmentItems")
  purchaseOrderItems      PurchaseOrderItem[]     @relation("ItemPurchaseOrderItems")
  itemPrices              ItemPrice[]             @relation("ItemPrices")
  itemSuppliers           ItemSupplier[]          @relation("ItemItemSuppliers")
  quotationItems          QuotationItem[]         @relation("ItemQuotationItems")
  projectOrders           ProjectOrder[]          @relation("ItemProjectOrders")
  itemCosts               ItemCost[]              @relation("ItemCosts")
  engineeringChanges      EngineeringChange[]     @relation("ItemECNs")
  materialLotConsumptions WorkOrderMaterialLot[]  @relation("MaterialLotItem")
  materialReturnItems     MaterialReturnItem[]
  projectOrderPrices      ProjectOrderPrice[]     @relation("ItemProjectOrderPrices")
  equipmentAppliedItems   EquipmentAppliedItem[]
  equipmentUsageHistories EquipmentUsageHistory[]

