# ── NCWatch → MES Agent 설정 (이 파일을 .env 로 복사해 사용) ─────────────────
# .env 는 비밀값을 포함합니다. 저장소/메신저/이메일로 공유하지 마세요.
# 기존 현장 PC 에 이미 .env 가 있으면 덮어쓰지 말고 아래 항목만 비교해 맞추세요.

# ── NCWatch 로컬 PostgreSQL (읽기 전용 조회) ───────────────────────────────
NCWATCH_DB_HOST=localhost
NCWATCH_DB_PORT=5433
NCWATCH_DB_NAME=ncwatch
NCWATCH_DB_USER=ncwatch
# 코드에 기본 비밀번호가 없습니다. 반드시 입력하세요.
NCWATCH_DB_PASSWORD=
NCWATCH_DB_SSL=false

# ── 수집 설비 (NCWatch DB 의 TBL_<이름>_STATUS 와 정확히 일치, 쉼표 구분) ──
# CNC-1 은 아직 NCWatch↔설비 통신이 미연결이어도 반드시 포함합니다(연결되면 자동 수집).
NCWATCH_MACHINES=CNC-1,CNC-8,CNC-9,MCT-6

# ── MES 수신 API ──────────────────────────────────────────────────────────
MES_API_URL=https://daewon-mes.vercel.app
# 운영 인증키(dwk_ 로 시작). 현장에서 set-agent-key.ps1 로 입력하세요. 이 파일에 직접 붙여넣어도 됩니다.
# 데모 키(gw-api-key-demo-001 등)는 사용할 수 없습니다.
MES_AGENT_KEY=

# ── 전송 주기 (밀리초) ─────────────────────────────────────────────────────
STATUS_INTERVAL_MS=10000
REPORT_INTERVAL_MS=3600000
HEARTBEAT_INTERVAL_MS=30000

# ── 선택 설정 (기본값이면 생략) ────────────────────────────────────────────
# 변경이 없는 설비를 이 간격마다 한 번은 재전송(마지막 수신시간 갱신). 0 이면 매 주기 전부 전송.
# STATUS_FORCE_SEND_MS=60000
# MES_REQUEST_TIMEOUT_MS=15000
# NCWATCH_DB_QUERY_TIMEOUT_MS=10000
# AGENT_LOG_RETENTION_DAYS=30
# AGENT_LOCK_PORT=47831
